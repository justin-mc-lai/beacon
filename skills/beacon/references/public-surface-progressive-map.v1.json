  "goal_transversal": {
    "public_id": "goal",
    "beacon_skill": "beacon-goal",
    "loom_skill": "loom-goal",
    "longrun_only_on_goal": true,
    "not_counted_in_six": true,
    "pipeline": [
      "plan",
      "truth",
      "design?",
      "implement",
      "qa",
      "release"
    ],
    "always_load": [
      "beacon-goal"
    ],
    "self_heal": {
      "pre": [
        {
          "id": "verify-context",
          "command": "beacon doctor verify-context -p . --strict --json",
          "user_facing": "检查项目上下文是否就绪",
          "auto": true
        },
        {
          "id": "verify-version-surfaces",
          "command": "beacon doctor verify-version-surfaces -p . --strict --json",
          "user_facing": "检查版本表面是否一致",
          "auto": true
        }
      ],
      "mid_on_block": [
        {
          "id": "repair-evidence-manifest",
          "command": "beacon doctor repair-evidence-manifest -p . --json",
          "user_facing": "尝试修复证据清单",
          "auto": true
        },
        {
          "id": "workspace-admit",
          "command": "beacon workspace admit -p . --json",
          "user_facing": "检查工作区准入",
          "auto": false
        }
      ],
      "post_release": [
        {
          "id": "post-release-local-install",
          "command": "beacon hooks run beacon-post-release-local-install -p . --confirm",
          "user_facing": "发布后安装/对齐本机环境（需确认）",
          "auto": false
        }
      ],
      "user_language": "never_expose_gov_skill_names_as_required_user_knowledge"
    },
    "mode_loads": [
      "mode:loop-goal"
    ],
    "merged": true
  },
