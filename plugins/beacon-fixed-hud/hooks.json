{
  "description": "Beacon v1.3.3 fixed HUD hook wiring for Codex",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/apple/Developer/Personal/products/beacon/plugins/beacon-fixed-hud/scripts/dispatch.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|refresh|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/apple/Developer/Personal/products/beacon/plugins/beacon-fixed-hud/scripts/dispatch.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionResume": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/apple/Developer/Personal/products/beacon/plugins/beacon-fixed-hud/scripts/dispatch.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionRefresh": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/apple/Developer/Personal/products/beacon/plugins/beacon-fixed-hud/scripts/dispatch.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
