      "acceptance_criteria": [
        {
          "ac_id": "AC-DGS-001",
          "description": "`goal run` 不自动 attach supervise；仅 `goal supervise` 进入 SupervisorSession.active（**Must**）"
        },
        {
          "ac_id": "AC-DGS-002",
          "description": "默认 heartbeat_interval_sec=120；可配置且 ≥30（**Must**）"
        },
        {
          "ac_id": "AC-DGS-003",
          "description": "每次 heartbeat/cmd/tick/supervise 事件 append execution.jsonl（**Must**）"
        },
        {
          "ac_id": "AC-DGS-004",
          "description": "checkpoint.json 含 last_substep + next_action；resume-pack 只吐 digest（**Must**）"
        },
        {
          "ac_id": "AC-DGS-005",
          "description": "stage 需工作时 idle≥interval 无 heartbeat → host_interrupted 或 stall_flag（**Must**）"
        },
        {
          "ac_id": "AC-DGS-006",
          "description": "host_interrupted ≠ stage_blocked；resume 回 last_substep（**Must**）"
        },
        {
          "ac_id": "AC-DGS-007",
          "description": "`tick --execute` 在 implement/qa 可派发工人；无 flag 不派发（**Must**）"
        },
        {
          "ac_id": "AC-DGS-008",
          "description": "supervisor/tick 不得在无 verifier refs 时 complete（**Must**）"
        },
        {
          "ac_id": "AC-DGS-009",
          "description": "release 永不被 supervise 自动确认（**Must**）"
        },
        {
          "ac_id": "AC-DGS-010",
          "description": "文档/CLI 不把 supervise 宣传为第二公共入口（**Must**）"
        },
        {
          "ac_id": "AC-DGS-011",
          "description": "禁止非 append 覆写 execution.jsonl（**Must**）"
        },
        {
          "ac_id": "AC-DGS-012",
          "description": "P2：sqlite FTS reindex/search 可选；结果非 complete 权威（**Should**）"
