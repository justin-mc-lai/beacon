      "description": "存在 single / team / ralph 运行摘要。"
    },
    {
      "id": "loading",
      "label": "加载中",
      "description": "项目详情正在聚合。"
    },
    {
      "id": "error",
      "label": "错误",
      "description": "详情聚合失败但给出恢复链路。"
    }
