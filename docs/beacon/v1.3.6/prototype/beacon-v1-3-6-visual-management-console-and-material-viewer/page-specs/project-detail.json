    },
    {
      "id": "draft",
      "label": "需求草稿",
      "description": "需求已建立但未冻结。"
    },
    {
      "id": "frozen",
      "label": "需求冻结",
      "description": "需求链与 prototype 都已冻结。"
    },
    {
      "id": "runtime-active",
