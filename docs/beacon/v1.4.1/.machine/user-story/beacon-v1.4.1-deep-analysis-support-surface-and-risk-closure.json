  "stories": [
    {
      "story_id": "US-001",
      "revision_id": "R1",
      "title": "beacon-v1.4.1-deep-analysis-support-surface-and-risk-closure",
      "priority": "medium",
      "status": "accepted",
      "items": [
        {
          "id": "AC-001",
          "kind": "ac",
          "theme": "support-skill-boundary",
          "text": "`beacon-deep` 被定义为 support skill / toolkit surface，而不是 `prd / user-story / test-case / implement / qa / release` 之外的新主阶段。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260509T131825259900",
          "accepted_at": "2026-05-09T05:18:39.276181+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.4.1/user-story/beacon-v1.4.1-deep-analysis-support-surface-and-risk-closure.md"
        },
        {
          "id": "AC-002",
          "kind": "ac",
          "theme": "public-entry",
          "text": "`beacon deep run` 是推荐公共入口，能够代表 scan、model、challenge、derive、route、verify 的完整 deep loop。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260509T131825259900",
          "accepted_at": "2026-05-09T05:18:39.276181+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.4.1/user-story/beacon-v1.4.1-deep-analysis-support-surface-and-risk-closure.md"
        },
        {
          "id": "AC-003",
          "kind": "ac",
          "theme": "hidden-toolkit",
          "text": "`beacon-toolkit-deep-loop`、`beacon-toolkit-state-machine`、`beacon-toolkit-test-delta`、`beacon-toolkit-risk-register` 可以作为内部模块存在，但默认不增加人类主入口。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260509T131825259900",
          "accepted_at": "2026-05-09T05:18:39.276181+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.4.1/user-story/beacon-v1.4.1-deep-analysis-support-surface-and-risk-closure.md"
        },
        {
          "id": "AC-004",
          "kind": "ac",
          "theme": "high-risk-trigger",
          "text": "payment、order、wallet、ranking、scoring、identity binding、invitation、relationship chain、reporting、migration、multi-role、multi-state、post-fact attribution 等高风险类别会触发 deep required 或 recommended 诊断。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260509T131825259900",
          "accepted_at": "2026-05-09T05:18:39.276181+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.4.1/user-story/beacon-v1.4.1-deep-analysis-support-surface-and-risk-closure.md"
        },
        {
          "id": "AC-005",
          "kind": "ac",
          "theme": "skip-reason",
          "text": "低风险静态页面、简单表单、stateless utility、visual-only change 和低风险配置变更可以显式记录 skip reason。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260509T131825259900",
          "accepted_at": "2026-05-09T05:18:39.276181+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.4.1/user-story/beacon-v1.4.1-deep-analysis-support-surface-and-risk-closure.md"
        },
        {
          "id": "AC-006",
          "kind": "ac",
          "theme": "qa-trigger",
          "text": "QA 中出现由业务建模缺失导致的 P0/P1/P2 缺陷时，可以重新触发 deep loop 作为结构性风险复盘。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260509T131825259900",
          "accepted_at": "2026-05-09T05:18:39.276181+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.4.1/user-story/beacon-v1.4.1-deep-analysis-support-surface-and-risk-closure.md"
        },
        {
          "id": "AC-007",
          "kind": "ac",
          "theme": "loop-state-machine",
          "text": "deep loop 至少覆盖 `scan_truth -> model_business -> challenge_gaps -> derive_delta -> classify_findings -> route_repairs -> verify_closure`。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260509T131825259900",
          "accepted_at": "2026-05-09T05:18:39.276181+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.4.1/user-story/beacon-v1.4.1-deep-analysis-support-surface-and-risk-closure.md"
        },
        {
          "id": "AC-008",
          "kind": "ac",
          "theme": "one-pass-closure",
          "text": "同一用户意图下，没有新增角色、实体、业务流程、状态机、事实源或跨面不变量时，deep run 应在同一 run 内给出 closure 或 route decision。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260509T131825259900",
          "accepted_at": "2026-05-09T05:18:39.276181+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.4.1/user-story/beacon-v1.4.1-deep-analysis-support-surface-and-risk-closure.md"
        },
        {
          "id": "AC-009",
          "kind": "ac",
          "theme": "reopen-conditions",
          "text": "只有用户新增 feature、role、state machine、business process、release-blocking evidence，或 QA/implementation evidence 暴露结构性缺口时，才开启新的 deep loop。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260509T131825259900",
          "accepted_at": "2026-05-09T05:18:39.276181+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.4.1/user-story/beacon-v1.4.1-deep-analysis-support-surface-and-risk-closure.md"
        },
        {
          "id": "AC-010",
          "kind": "ac",
          "theme": "artifact-family",
          "text": "deep artifact family 包含 deep analysis report、state machine report、deep test delta、risk register、deep loop trace、deep closure brief。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260509T131825259900",
          "accepted_at": "2026-05-09T05:18:39.276181+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.4.1/user-story/beacon-v1.4.1-deep-analysis-support-surface-and-risk-closure.md"
        },
        {
          "id": "AC-011",
          "kind": "ac",
          "theme": "loop-trace-required",
          "text": "deep loop trace 必须记录 user intent snapshot、iteration list、finding classification、route decision、closure decision、stop reason 和 next allowed route。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260509T131825259900",
          "accepted_at": "2026-05-09T05:18:39.276181+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.4.1/user-story/beacon-v1.4.1-deep-analysis-support-surface-and-risk-closure.md"
        },
        {
          "id": "AC-012",
          "kind": "ac",
          "theme": "closure-brief-required",
          "text": "deep closure brief 必须记录 deep requirement state、verdict、executed delta cases、open findings、waived findings、accepted backlog risks 和 release recommendation。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260509T131825259900",
          "accepted_at": "2026-05-09T05:18:39.276181+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.4.1/user-story/beacon-v1.4.1-deep-analysis-support-surface-and-risk-closure.md"
        },
        {
          "id": "AC-013",
          "kind": "ac",
          "theme": "route-map",
          "text": "PRD gap 路由到 `change/refreeze`，user-story gap 路由到 user-story supplement 或 `change/refreeze`，acceptance gap 路由到 test-case delta。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260509T131825259900",
          "accepted_at": "2026-05-09T05:18:39.276181+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.4.1/user-story/beacon-v1.4.1-deep-analysis-support-surface-and-risk-closure.md"
        },
        {
          "id": "AC-014",
          "kind": "ac",
          "theme": "implementation-qa-route",
          "text": "implementation gap 路由到 implement repair handoff，QA evidence gap 路由到 supplemental QA loop。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260509T131825259900",
          "accepted_at": "2026-05-09T05:18:39.276181+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.4.1/user-story/beacon-v1.4.1-deep-analysis-support-surface-and-risk-closure.md"
        },
        {
          "id": "AC-015",
          "kind": "ac",
          "theme": "release-route",
          "text": "release risk 路由到 release closure、waiver 或 backlog decision。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260509T131825259900",
          "accepted_at": "2026-05-09T05:18:39.276181+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.4.1/user-story/beacon-v1.4.1-deep-analysis-support-surface-and-risk-closure.md"
        },
        {
          "id": "AC-016",
          "kind": "ac",
          "theme": "no-orphan-finding",
          "text": "每个 deep finding 必须有 classification、route decision、closure decision 或 backlog decision。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260509T131825259900",
          "accepted_at": "2026-05-09T05:18:39.276181+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.4.1/user-story/beacon-v1.4.1-deep-analysis-support-surface-and-risk-closure.md"
        },
        {
          "id": "AC-017",
          "kind": "ac",
          "theme": "pre-qa-delta",
          "text": "deep 可以从 PRD、用户故事、状态机、事实源图和现有 test-case 中派生缺失测试，形成 deep test delta。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260509T131825259900",
          "accepted_at": "2026-05-09T05:18:39.276181+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.4.1/user-story/beacon-v1.4.1-deep-analysis-support-surface-and-risk-closure.md"
        },
        {
          "id": "AC-018",
          "kind": "ac",
          "theme": "qa-execution-boundary",
          "text": "deep 不直接替代 QA 执行，adopted deep delta 必须进入 test-case 或 supplemental QA 后由 `qa` 验收。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260509T131825259900",
          "accepted_at": "2026-05-09T05:18:39.276181+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.4.1/user-story/beacon-v1.4.1-deep-analysis-support-surface-and-risk-closure.md"
        },
        {
          "id": "AC-019",
          "kind": "ac",
          "theme": "qa-feedback-loop",
          "text": "QA 缺陷只有在指向结构性状态、事实源、一致性或需求缺口时才重新进入 deep loop。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260509T131825259900",
          "accepted_at": "2026-05-09T05:18:39.276181+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.4.1/user-story/beacon-v1.4.1-deep-analysis-support-surface-and-risk-closure.md"
        },
        {
          "id": "AC-020",
          "kind": "ac",
          "theme": "release-supplement",
          "text": "release 可以消费 deep closure brief、risk register、deep loop trace 和 explicit skip reason 作为补充证据。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260509T131825259900",
          "accepted_at": "2026-05-09T05:18:39.276181+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.4.1/user-story/beacon-v1.4.1-deep-analysis-support-surface-and-risk-closure.md"
        },
        {
          "id": "AC-021",
          "kind": "ac",
          "theme": "blocking-findings",
          "text": "P0/P1/P2 release-blocking deep findings 必须 closed 或 waived 后才允许 release readiness 通过。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260509T131825259900",
          "accepted_at": "2026-05-09T05:18:39.276181+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.4.1/user-story/beacon-v1.4.1-deep-analysis-support-surface-and-risk-closure.md"
        },
        {
          "id": "AC-022",
          "kind": "ac",
          "theme": "backlog-is-explicit",
          "text": "backlog findings 不默认阻断 release，但必须有 accepted backlog decision。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260509T131825259900",
          "accepted_at": "2026-05-09T05:18:39.276181+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.4.1/user-story/beacon-v1.4.1-deep-analysis-support-surface-and-risk-closure.md"
        },
        {
          "id": "AC-023",
          "kind": "ac",
          "theme": "no-direct-truth-write",
          "text": "deep artifacts、machine mirrors、runtime projections 和 learning hints 都不得直接改写 frozen PRD、user-story 或 test-case truth。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260509T131825259900",
          "accepted_at": "2026-05-09T05:18:39.276181+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.4.1/user-story/beacon-v1.4.1-deep-analysis-support-surface-and-risk-closure.md"
        },
        {
          "id": "AC-024",
          "kind": "ac",
          "theme": "accepted-change-route",
          "text": "被接受的 requirement gap 必须通过 `change/refreeze` 更新 canonical truth，然后再进入 implement、QA 和 release。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260509T131825259900",
          "accepted_at": "2026-05-09T05:18:39.276181+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.4.1/user-story/beacon-v1.4.1-deep-analysis-support-surface-and-risk-closure.md"
        },
        {
          "id": "AC-025",
          "kind": "ac",
          "theme": "projection-not-truth",
          "text": "`.machine` 和 `.beacon` 产物只能作为 compiled projection、cache 或 audit evidence，不能成为第二 truth root。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260509T131825259900",
          "accepted_at": "2026-05-09T05:18:39.276181+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.4.1/user-story/beacon-v1.4.1-deep-analysis-support-surface-and-risk-closure.md"
        },
        {
          "id": "AC-026",
          "kind": "ac",
          "theme": "three-piece-freeze",
          "text": "PRD、user-story、test-case 三件套均存在并通过 Beacon 校验后，可以生成 frozen revision baseline。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260509T131825259900",
          "accepted_at": "2026-05-09T05:18:39.276181+00:00",
          "changed_in_revision": "R1",
