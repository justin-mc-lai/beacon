        },
        {
          "id": "AC-028",
          "kind": "ac",
          "theme": "version-safety",
          "text": "v1.4.1 仍为 planning-only line，冻结 requirement package 不改变当前 runtime release line、docs default line 或 package version。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
