        "section_count": 2,
        "sections": {
          "architecture": [
            "v1.6.7 parity: heartbeat 120s default, append-only log, host_interrupt ≠ stage_blocked, verifier complete, human release.",
            "v2 delta: **AgentDriver** owned by Rust orchestrator so \"one command\" can re-enter agent turns without user typing「继续」each time (still not a silent fake-complete daemon)."
          ],
          "business_flow": [
            "User one-shot: `beacon goal run \"...\" --longrun` (or skill `$beacon-goal` with longrun flag).",
            "Orchestrator creates GoalRun; `--longrun` attaches SupervisorSession for this run only.",
            "Driver selects next_action from stage + checkpoint; spawns/resumes agent turn with **digest-only** context.",
            "Every ≤120s (or substep): heartbeat + execution.jsonl append.",
            "Host turn ends / context full → host_interrupted + checkpoint; Driver **auto-requeues** next turn unless blocked≥3 or awaiting human release.",
            "QA workers via tick --execute / driver; complete only with verifier refs.",
            "release_pending always human."
          ]
        },
