      "acceptance_criteria": [
        {
          "ac_id": "AC-WC-001",
          "description": "提供 `verify_clean_workspace`（或等价）统一出口 gate，读取完整 `git status --porcelain=v1 -uall`，按 artifact_role 分类并对 unclassified dirty fail-closed"
        },
        {
          "ac_id": "AC-WC-002",
          "description": "dirty manifest 至少区分 `canonical_truth`、`formal_evidence`、`machine_projection`、`host_projection`、`runtime_private`、`forbidden`，并给出每类允许动作"
        },
        {
          "ac_id": "AC-WC-003",
          "description": "formal evidence manifest 仅可包含 tracked、branch-carried、hash-valid 的正式证据；local hook/runtime evidence 必须进入 runtime manifest 或 ignored state，不能支撑 QA/release verdict"
        },
        {
          "ac_id": "AC-WC-004",
          "description": "tasks.md 中 `[x] + evidence=PATH` 必须要求 evidence 文件存在、可解析、tracked/promoted、并被 evidence.md 或 formal manifest 索引；`[ ] + existing evidence` 必须作为 orphan evidence 阻断或要求清理"
        },
        {
          "ac_id": "AC-WC-005",
          "description": "agent_trace 写入前必须执行 redline/allowlist gate，禁止 `full_chat`、非空 `chat_body`、raw messages、prompt/completion、token/cookie/env/private key 等字段写入或 promotion"
        },
        {
          "ac_id": "AC-WC-006",
          "description": "raw `.beacon/traces/**` 默认分类为 `runtime_private`；正式证据只能使用脱敏 digest，digest 含 event_count、harness、feature_slug、reason_codes、sha256、`redaction_status=pass`"
        },
        {
          "ac_id": "AC-WC-007",
          "description": "`beacon-post-release-local-install` 默认在临时 git worktree 或等价隔离区执行 project-local agent/context projection；原 project_root 运行前后快照不得新增 tracked dirty"
        },
        {
          "ac_id": "AC-WC-008",
          "description": "`quiet-worktree`/skip-worktree 只能作为开发者降噪；`verify-clean-workspace --strict` 必须揭示 skip-worktree hidden dirty，且不允许 skip-worktree hidden dirty 进入 `clean_verified` 或被当作 clean proof"
        },
        {
          "ac_id": "AC-WC-009",
          "description": "host projection 必须二选一：local-only ignore/skip 策略，或 deterministic `surface-sync` commit；禁止 release 后留下未提交 `.agents/.codex/.cursor/.trae/.windsurf` 投影改动"
        },
        {
          "ac_id": "AC-WC-010",
          "description": "truth/freeze/qa/release/post-release 出口都必须调用 clean-workspace gate 或记录同 schema verification bundle；失败 reason_code 明确指向 commit、promote、ignore、clean 或 rerun route"
        },
        {
          "ac_id": "AC-WC-011",
          "description": "pre-push/main-push profile 必须阻断 generator dirty 与 unclassified dirty，不再只检查 staged business paths；business code main guard 仍保留为 defense-in-depth"
        },
        {
          "ac_id": "AC-WC-012",
          "description": "release human gate 保持最高边界；clean-workspace pass 不等于 release pass，post-release hook pass 也不等于 QA/release verdict"
        }
      ],
