          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.6.11/features/design-craft-absorption-v1611/truth.md"
        },
        {
          "id": "AC-004",
          "kind": "ac",
          "theme": "write-guard",
          "text": "improve 在产品源上只读；计划只写入受控 craft plan 根目录；试图改产品源必须被拒绝。",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
          "verified_by_run_id": null,
          "accepted_at": null,
          "changed_in_revision": null,
