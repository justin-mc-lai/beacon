        },
        {
          "id": "AC-002",
          "kind": "ac",
          "theme": "craft-refs",
          "text": "四个 module（baseline/a11y/motion/improve）均有 Beacon-owned progressive reference，并可被 design craft router 选中。",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
          "verified_by_run_id": null,
          "accepted_at": null,
          "changed_in_revision": null,
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.6.11/features/design-craft-absorption-v1611/truth.md"
        },
        {
          "id": "AC-003",
          "kind": "ac",
          "theme": "authority-schema",
          "text": "craft 输出必须标记 `support_only=true` 且 `truth_source=false`；缺省或伪造权限字段时路由/校验失败。",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
          "verified_by_run_id": null,
          "accepted_at": null,
          "changed_in_revision": null,
