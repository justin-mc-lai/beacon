          "kind": "ac",
          "theme": "public-surface",
          "text": "Beacon 仅通过 `beacon-design` public harness 暴露 craft；不新增 1+6 public skill，不新增主生命周期 stage。",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
          "verified_by_run_id": null,
          "accepted_at": null,
          "changed_in_revision": "R2",
