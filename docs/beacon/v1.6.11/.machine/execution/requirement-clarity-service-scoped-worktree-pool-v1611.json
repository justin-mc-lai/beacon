      "acceptance_criteria": [
        {
          "ac_id": "AC-SSP-001",
          "description": "Rolo/multi-git governance 必须支持显式 `role=primary` root；global service bindings 的 `repo_root` 只能指稳定 repo root，不能指版本 worktree；`multi_git_workspace` 是合法 topology_kind"
        },
        {
          "ac_id": "AC-SSP-002",
          "description": "Governance parser/render/doctor 必须保留 primary binding 顺序无关语义，metadata verify 接受 `multi_git_workspace`，并在 service binding 指向 `.worktrees/feature-*` 时给出可执行迁移结果"
        },
        {
          "ac_id": "AC-SSP-003",
          "description": "Workspace pool 必须支持 `workspace-pool-v2` 或等价 schema：一个 feature parent lease 下包含 services lease map，服务 lease 记录 service_key、repo_root、branch、base_branch、worktree_path、lease_holder、leased_at、released_at、git_head；release 只归还 lease，不删除 worktree"
        },
        {
          "ac_id": "AC-SSP-004",
          "description": "Implement admission 对 multi-git/nested child repo 必须为每个 participating 且 writable service 创建或复用真实 service worktree；分支来自 `per_service_canonical_branch`，baseline 来自 `per_service_baseline_branch`，路径来自 `service_worktree_path_pattern` 或默认 `.beacon/worktrees/<version>/<feature_slug>/services/<service_key>`"
        },
        {
          "ac_id": "AC-SSP-005",
          "description": "GitScopeGraph/topology gate/write guard 必须以 explicit primary + service scopes 汇总；parent worktree 不能授权 service write；任何 service branch/cwd/head/baseline mismatch 都阻断 implement dispatch"
        },
        {
          "ac_id": "AC-SSP-006",
          "description": "Rolo v2.3.3/v2.3.4 fixture 必须验证：primary 是 `/Users/apple/Developer/Company/rolo`，participating service map 精确覆盖版本合同，`workspace_admission_cwd_mismatch` 不再由 first-service-primary 误判触发"
        },
        {
          "ac_id": "AC-SSP-007",
          "description": "Existing single_repo、dedicated-worktree、pooled feature-level lease 行为保持回归通过；本包不得引入旧 package shape 兼容 reader、soft skip write authorization 或 hook-only gate"
        }
      ],
      "bound_ac_ids": [
        "AC-SSP-003",
        "AC-SSP-004"
      ],
