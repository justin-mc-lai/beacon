{
  "schema_version": "1.0",
  "design_governance_required": true,
  "design_generation_mode": "description-as-design",
  "interactive_prototype_required": true,
  "guidance_anchors": [
    "frontend-design",
    "web-design-guidelines"
  ],
  "design_mode_references": [
    "Beacon v1.3.4 main PRD lifecycle-first board model",
    "Beacon v1.3.4 one-person-company ops board model",
    "PocketBase as control plane",
    "not formal delivery truth",
    "Beacon admin-workbench prototype discipline",
    "human minimal surface with runtime drilldown only"
  ],
  "visual_direction": "disciplined / admin-workbench",
  "typography": {
    "display": "Fraunces",
    "body": "IBM Plex Sans",
    "mono": "JetBrains Mono",
    "scale": [
      48,
      32,
      24,
      18,
      16,
      14,
      12
    ]
  },
  "palette": {
    "primary": "#1F6FEB",
    "secondary": "#0F172A",
    "accent": "#1F6FEB"
  },
  "spacing_scale": "4-8-12-16-24-32",
  "radius_scale": "10/14/18",
  "shadow_style": "disciplined-elevation",
  "motion": "minimal-functional",
  "component_rules": [
    "pages must consume shared tokens",
    "focus-visible styling is required",
    "reduced-motion must be honored"
  ],
  "anti_generic_rules": [
    "avoid Inter/Roboto/Arial/system-only default stacks",
    "avoid purple-on-white generic gradients",
    "avoid template-like undifferentiated layouts"
  ]
}
