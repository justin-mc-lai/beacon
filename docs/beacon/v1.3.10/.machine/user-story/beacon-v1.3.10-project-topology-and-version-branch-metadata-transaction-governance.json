        },
        {
          "id": "AC-007",
          "kind": "ac",
          "theme": "canonical-envelope",
          "text": "任一元信息变更都先形成单一 canonical metadata envelope。",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
          "verified_by_run_id": null,
          "accepted_at": null,
          "changed_in_revision": null,
