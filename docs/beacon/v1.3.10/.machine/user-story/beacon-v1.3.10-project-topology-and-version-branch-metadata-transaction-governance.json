        {
          "id": "AC-004",
          "kind": "ac",
          "theme": "version-contract",
          "text": "Beacon 能为某个版本保存参与交付的 service set。",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
          "verified_by_run_id": null,
