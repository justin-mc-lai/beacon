        },
        {
          "id": "AC-005",
          "kind": "ac",
          "theme": "canonical-branch",
          "text": "Beacon 能为每个参与 service 保存该版本线对应的 canonical branch contract。",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
          "verified_by_run_id": null,
