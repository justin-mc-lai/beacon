        },
        {
          "id": "AC-008",
          "kind": "ac",
          "theme": "three-sink-transaction",
          "text": "同一笔元信息事务会共享一致 transaction metadata，并投影到 human sink、machine sink、sqlite sink。",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
          "verified_by_run_id": null,
          "accepted_at": null,
          "changed_in_revision": null,
