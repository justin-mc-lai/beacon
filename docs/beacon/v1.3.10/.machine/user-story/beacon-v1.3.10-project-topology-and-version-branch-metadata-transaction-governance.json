        },
        {
          "id": "AC-006",
          "kind": "ac",
          "theme": "protected-branch-rules",
          "text": "Beacon 能表达 protected branch 禁写、可写分支约束与违例处理策略。",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
          "verified_by_run_id": null,
          "accepted_at": null,
