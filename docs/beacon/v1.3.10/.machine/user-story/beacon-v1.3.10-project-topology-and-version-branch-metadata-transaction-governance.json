          "source": "user-story:docs/beacon/v1.3.10/user-story/beacon-v1.3.10-project-topology-and-version-branch-metadata-transaction-governance.md"
        },
        {
          "id": "AC-013",
          "kind": "ac",
          "theme": "support-surface",
          "text": "Beacon 提供确定性的人类面元信息子 skill，名称固定为 `beacon:beacon-project-metadata`。",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
          "verified_by_run_id": null,
          "accepted_at": null,
          "changed_in_revision": null,
          "story_id": "",
          "details": [],
          "source": "user-story:docs/beacon/v1.3.10/user-story/beacon-v1.3.10-project-topology-and-version-branch-metadata-transaction-governance.md"
        },
        {
          "id": "AC-014",
          "kind": "ac",
          "theme": "minimal-human-surface",
          "text": "该 skill 的宿主命令面固定收口到 `beacon doctor metadata show/create/update/delete/list/verify`，不新增一级公开命令。",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
          "verified_by_run_id": null,
          "accepted_at": null,
          "changed_in_revision": null,
          "story_id": "",
          "details": [],
          "source": "user-story:docs/beacon/v1.3.10/user-story/beacon-v1.3.10-project-topology-and-version-branch-metadata-transaction-governance.md"
        },
        {
          "id": "AC-015",
          "kind": "ac",
          "theme": "crud-verify-coverage",
          "text": "该 surface 至少支持新增、查询、修改、删除、列表查看与显式校验 metadata contract。",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
          "verified_by_run_id": null,
          "accepted_at": null,
          "changed_in_revision": null,
          "story_id": "",
          "details": [],
          "source": "user-story:docs/beacon/v1.3.10/user-story/beacon-v1.3.10-project-topology-and-version-branch-metadata-transaction-governance.md"
        },
        {
          "id": "AC-016",
          "kind": "ac",
          "theme": "transaction-boundary",
          "text": "该 surface 的增删改动作必须走 canonical transaction，而不是直接改某一个 sink。",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
          "verified_by_run_id": null,
          "accepted_at": null,
          "changed_in_revision": null,
