        },
        {
          "id": "AC-017",
          "kind": "ac",
          "theme": "absolute-root",
          "text": "人类可见输出会显式显示绝对 `project_root`。",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
          "verified_by_run_id": null,
          "accepted_at": null,
          "changed_in_revision": null,
