        },
        {
          "id": "AC-010",
          "kind": "ac",
          "theme": "prompt-consumption",
          "text": "当 metadata 已存在时，prompt 层把项目拓扑、service repo、canonical branch 当作固定输入，而不是重新推断。",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
          "verified_by_run_id": null,
          "accepted_at": null,
