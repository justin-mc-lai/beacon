        },
        {
          "id": "AC-018",
          "kind": "ac",
          "theme": "artifact-clarity",
          "text": "元信息相关的人类可见输出能清楚标识 human sink、machine sink 与 sqlite transaction 标识。",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
          "verified_by_run_id": null,
