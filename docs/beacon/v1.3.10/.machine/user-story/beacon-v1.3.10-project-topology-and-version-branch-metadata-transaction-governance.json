        },
        {
          "id": "AC-003",
          "kind": "ac",
          "theme": "deterministic-resolution",
          "text": "当元信息已存在时，Beacon 执行前能直接确定目标 service repo，而不是重新探测。",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
          "verified_by_run_id": null,
          "accepted_at": null,
