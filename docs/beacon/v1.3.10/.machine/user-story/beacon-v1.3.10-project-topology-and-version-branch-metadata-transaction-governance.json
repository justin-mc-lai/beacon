        },
        {
          "id": "AC-012",
          "kind": "ac",
          "theme": "deterministic-block",
          "text": "当前 service、branch 或 worktree 状态不满足 contract 时，Beacon 会确定性阻断并给出修复指引。",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
          "verified_by_run_id": null,
          "accepted_at": null,
          "changed_in_revision": null,
