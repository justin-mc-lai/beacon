        },
        {
          "id": "AC-011",
          "kind": "ac",
          "theme": "runtime-consumption",
          "text": "runtime 层在 implement/qa/release 前直接读取 metadata contract 进行 repo/branch/worktree 校验。",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
          "verified_by_run_id": null,
          "accepted_at": null,
          "changed_in_revision": null,
