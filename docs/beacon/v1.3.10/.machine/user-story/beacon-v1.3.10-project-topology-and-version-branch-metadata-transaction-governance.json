        },
        {
          "id": "AC-009",
          "kind": "ac",
          "theme": "drift-detectable",
          "text": "status/doctor/gate/review 能检测元信息投影缺失、校验和漂移、失败事务或过期 sqlite projection。",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
          "verified_by_run_id": null,
          "accepted_at": null,
          "changed_in_revision": null,
