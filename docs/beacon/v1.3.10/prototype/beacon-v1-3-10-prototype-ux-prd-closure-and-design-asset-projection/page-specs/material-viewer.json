  "analysis": {
    "target_user": "查看 Beacon 物料的人",
    "decision_focus": [
      "当前要看哪个版本、哪类文档、哪个 feature。",
      "Markdown 物料是否存在，并能否稳定切换浏览。",
      "这只是只读消费面，真相仍在本地 docs/beacon 与 .beacon。"
    ],
    "layout_rules": [
      "左侧负责层级导航，右侧负责稳定阅读，职责不能混乱。",
      "来源路径只做可信来源说明，不压过正文阅读体验。",
      "版本切换要靠近树和目录，不要藏到正文底部。"
    ],
    "noise_guardrail": "物料页必须坚持只读查看，不暴露机器索引或编辑入口。"
  },
  "page_intent_contract": {
    "why_this_page_exists": "按 version -> document type -> feature 提供只读 Markdown 浏览。",
    "decision_supported": "当前要看哪个版本、哪类文档、哪个 feature。",
    "must_show_first": [
      "版本树",
      "文档类型列表"
    ],
    "must_not_show": [
      "transaction_id",
      "projection metadata",
      "无边界 runtime 明细"
    ],
    "entry_conditions": [
      "用户进入 `material-viewer` 需要先获得当前上下文。",
      "当前 requirement truth 已经明确该页承担的主判断。"
    ],
    "exit_actions": [
      {
        "label": "打开文档",
        "target": "material-document-detail"
      },
      {
        "label": "返回项目详情",
        "target": "project-detail"
      }
    ]
  },
  "layout_lines": [
    "+-----------------------------------------------------------------------------------+",
    "| 顶栏：返回项目详情 | 项目物料查看器 | 当前项目 | 只读模式                         |",
