        {
          "id": "AC-012",
          "kind": "ac",
          "theme": "Backward Compatibility",
          "text": "未启用 design governance 的旧 prototype line 不被破坏，但必须显式标记不具备 design-governed guarantee",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-v112-release",
          "verified_by_run_id": "run-v112-release",
