      "items": [
        {
          "id": "AC-001",
          "kind": "ac",
          "theme": "Plan Compiler",
          "text": "Beacon 必须存在 `prd-us-to-plan` 语义，把 `user-story + prd + test-case` 编译成 implementation plan",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-v112-release",
          "verified_by_run_id": "run-20260402T061014055287",
          "accepted_at": "2026-04-01T22:16:19.908855+00:00",
          "changed_in_revision": "R1"
        },
        {
          "id": "AC-002",
          "kind": "ac",
          "theme": "Plan Artifact",
          "text": "implementation plan 必须有 machine-readable artifact 与 human-readable artifact，且可被 implement / status / writeback 消费",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-v112-release",
          "verified_by_run_id": "run-20260402T061014055287",
          "accepted_at": "2026-04-01T22:16:19.908855+00:00",
          "changed_in_revision": "R1"
        },
        {
          "id": "AC-003",
          "kind": "ac",
          "theme": "Baseline Binding",
          "text": "plan 必须绑定当前 version、revision_id 与 frozen baseline truth，未对齐时不得进入 implement",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-v112-release",
          "verified_by_run_id": "run-20260402T061014055287",
