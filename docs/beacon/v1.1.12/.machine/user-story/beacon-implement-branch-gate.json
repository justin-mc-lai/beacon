          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-v112-release",
          "verified_by_run_id": "run-v112-release",
          "accepted_at": "2026-04-01T22:06:59.733959+00:00",
          "changed_in_revision": "R1"
        },
