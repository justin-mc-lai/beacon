      "items": [
        {
          "id": "AC-001",
          "kind": "ac",
          "theme": "Live Check",
          "text": "`implement run` 进入 runner 解析前必须执行 live git branch preflight",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-v112-release",
          "verified_by_run_id": "run-v112-release",
          "accepted_at": "2026-04-01T22:06:59.733959+00:00",
          "changed_in_revision": "R1"
        },
        {
          "id": "AC-002",
          "kind": "ac",
          "theme": "Exact Branch",
          "text": "对 `--version vX.Y.Z`，实现阶段必须要求 `current_branch == beacon/vX.Y.Z`",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-v112-release",
          "verified_by_run_id": "run-v112-release",
          "accepted_at": "2026-04-01T22:06:59.733959+00:00",
          "changed_in_revision": "R1"
        },
        {
          "id": "AC-003",
          "kind": "ac",
          "theme": "No Tag Shortcut",
          "text": "implement 阶段不得因为 exact tag 命中版本而放行 detached HEAD / tag-only 状态",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-v112-release",
          "verified_by_run_id": "run-v112-release",
          "accepted_at": "2026-04-01T22:06:59.733959+00:00",
          "changed_in_revision": "R1"
        },
        {
          "id": "AC-004",
          "kind": "ac",
          "theme": "Unified Surface",
          "text": "`implement run`、`implement check-branch`、workflow implementation delegate 必须共用同一套分支判断逻辑",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-v112-release",
          "verified_by_run_id": "run-v112-release",
          "accepted_at": "2026-04-01T22:06:59.733959+00:00",
          "changed_in_revision": "R1"
        },
        {
          "id": "AC-005",
          "kind": "ac",
          "theme": "Blocked Reason",
          "text": "分支不匹配时返回结构化 blocked 结果，至少包含 `expected_branch/current_branch/reason_codes/recommended_command`",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-v112-release",
          "verified_by_run_id": "run-v112-release",
          "accepted_at": "2026-04-01T22:06:59.733959+00:00",
          "changed_in_revision": "R1"
        },
        {
          "id": "AC-006",
          "kind": "ac",
          "theme": "Preflight Artifact",
          "text": "每次 implement preflight 都写出 `.beacon/implement/<run_id>/branch-preflight.json`",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-v112-release",
          "verified_by_run_id": "run-v112-release",
          "accepted_at": "2026-04-01T22:06:59.733959+00:00",
          "changed_in_revision": "R1"
        },
        {
          "id": "AC-007",
          "kind": "ac",
          "theme": "Runner Isolation",
          "text": "preflight blocked 时不得继续解析或执行 runner",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-v112-release",
          "verified_by_run_id": "run-v112-release",
          "accepted_at": "2026-04-01T22:06:59.733959+00:00",
          "changed_in_revision": "R1"
        },
        {
