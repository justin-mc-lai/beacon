          "details": [],
          "source": "user-story:docs/beacon/v1.4.10/user-story/lifecycle-boundary-hook-advisory-and-confirmed-execution.md"
        },
        {
          "id": "AC-004",
          "kind": "ac",
          "theme": "Manual confirmation guard",
          "text": "Given a `manual_confirmed` hook is run without `--confirm`, the run is blocked with `manual_confirmation_required` and `side_effect_executed` remains false.",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
          "verified_by_run_id": null,
          "accepted_at": null,
          "changed_in_revision": null,
