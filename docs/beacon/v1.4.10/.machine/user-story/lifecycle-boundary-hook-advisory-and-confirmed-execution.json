        },
        {
          "id": "AC-003",
          "kind": "ac",
          "theme": "Safe automatic planning",
          "text": "Automatic hook advisory may plan hooks and may dry-run no-side-effect checks, but it does not execute side-effect follow-up.",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
          "verified_by_run_id": null,
          "accepted_at": null,
          "changed_in_revision": null,
