        },
        {
          "id": "AC-005",
          "kind": "ac",
          "theme": "Confirmed execution path",
          "text": "Given the operator runs the recommended command with `--confirm`, the hook executes its restricted follow-up and writes hook evidence.",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
          "verified_by_run_id": null,
          "accepted_at": null,
