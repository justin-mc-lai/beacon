          "id": "AC-001",
          "kind": "ac",
          "theme": "Boundary discovery",
          "text": "Given a lifecycle boundary such as `post_release`, Beacon discovers enabled project hooks from `docs/beacon/hooks/<hook-id>.md` whose hook code matches the boundary.",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
          "verified_by_run_id": null,
