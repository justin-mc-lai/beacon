        {
          "id": "AC-002",
          "kind": "ac",
          "theme": "Release follow-up advisory",
          "text": "Given `release check` passes and an applicable `post_release` hook exists, the release output includes a hook advisory with hook id, plan status, trigger policy, evidence paths, and a recommended confirmed-run command.",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
          "verified_by_run_id": null,
          "accepted_at": null,
