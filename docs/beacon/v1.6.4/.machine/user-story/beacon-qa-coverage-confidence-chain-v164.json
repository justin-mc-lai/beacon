        {
          "id": "AC-003",
          "kind": "ac",
          "theme": "confidence-chain-field",
          "text": "`build_qa_profile_completeness` 输出含 `confidence_chain`（每层置信度 + 依赖来源 + gap 标记）；projection 同步（**Must**）",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260702T064422Z-55c5",
