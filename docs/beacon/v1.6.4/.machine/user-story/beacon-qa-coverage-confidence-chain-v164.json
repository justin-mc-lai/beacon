        },
        {
          "id": "AC-002",
          "kind": "ac",
          "theme": "gap-detection",
          "text": "层间 gap 检测：下层 skipped/missing/blocked 时，上层置信度被削弱并标记 `downstream_gap`（**Must**）",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260702T064422Z-55c5",
          "verified_by_run_id": "run-20260702T144429722786",
