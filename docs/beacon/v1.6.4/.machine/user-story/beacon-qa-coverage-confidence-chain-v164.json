        {
          "id": "AC-004",
          "kind": "ac",
          "theme": "break-block",
          "text": "断链 fail-closed：链终点（browser_e2e）缺失或任一依赖层 gap → profile `partial/blocked`，不显示 complete（**Must**，UD-002）",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260702T064422Z-55c5",
