      "status": "accepted",
      "items": [
        {
          "id": "AC-001",
          "kind": "ac",
          "theme": "runner-registered",
          "text": "`BROWSER_RUNNER_REGISTRY` 含 `playwright-extension`；`default_browser_runner_command('playwright-extension')` 返回非空可执行命令（**Must**）",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260702T064351Z-65dd",
          "verified_by_run_id": "run-20260702T144357501746",
          "accepted_at": "2026-07-02T06:44:08.892004+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.6.4/features/beacon-qa-chrome-extension-e2e-v164/truth.md"
        },
        {
          "id": "AC-002",
          "kind": "ac",
          "theme": "load-extension",
          "text": "runner adapter 透传 `--load-extension=<path>` 到 Chrome 启动参数；扩展包加载失败时 block（reason_code `extension_load_failed`）（**Must**）",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260702T064351Z-65dd",
          "verified_by_run_id": "run-20260702T144357501746",
          "accepted_at": "2026-07-02T06:44:08.892004+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.6.4/features/beacon-qa-chrome-extension-e2e-v164/truth.md"
        },
        {
          "id": "AC-003",
          "kind": "ac",
          "theme": "headless-new",
          "text": "runner 使用 `--headless=new`（旧 headless 不支持扩展）；默认 headless 模式下扩展可加载（**Must**）",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260702T064351Z-65dd",
          "verified_by_run_id": "run-20260702T144357501746",
          "accepted_at": "2026-07-02T06:44:08.892004+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.6.4/features/beacon-qa-chrome-extension-e2e-v164/truth.md"
        },
        {
          "id": "AC-004",
          "kind": "ac",
          "theme": "extension-id-fixed",
          "text": "支持固定 extension ID（manifest `key` field 或 computed key）；测试可解析并复用该 ID（**Must**）",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260702T064351Z-65dd",
          "verified_by_run_id": "run-20260702T144357501746",
          "accepted_at": "2026-07-02T06:44:08.892004+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.6.4/features/beacon-qa-chrome-extension-e2e-v164/truth.md"
        },
        {
          "id": "AC-005",
          "kind": "ac",
          "theme": "extension-page-nav",
          "text": "runner 能导航到 `chrome-extension://<id>/<page>.html` 并断言页面内容（**Must**）",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260702T064351Z-65dd",
          "verified_by_run_id": "run-20260702T144357501746",
          "accepted_at": "2026-07-02T06:44:08.892004+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.6.4/features/beacon-qa-chrome-extension-e2e-v164/truth.md"
        },
        {
          "id": "AC-006",
          "kind": "ac",
          "theme": "popup-test",
          "text": "popup 测试支持：`action.openPopup()` 或 tab-ID URL 注入（`popup.html?tab=<id>`）；能断言 popup DOM（**Must**）",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260702T064351Z-65dd",
          "verified_by_run_id": "run-20260702T144357501746",
          "accepted_at": "2026-07-02T06:44:08.892004+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.6.4/features/beacon-qa-chrome-extension-e2e-v164/truth.md"
        },
        {
          "id": "AC-007",
          "kind": "ac",
          "theme": "service-worker-target",
          "text": "runner 能检测 service worker target（`waitForTarget(type==='service_worker')`）；能 evaluate SW 上下文（如 `chrome.storage`）；支持 SW 终止测试（**Must**）",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260702T064351Z-65dd",
          "verified_by_run_id": "run-20260702T144357501746",
          "accepted_at": "2026-07-02T06:44:08.892004+00:00",
          "changed_in_revision": "R1",
