        },
        {
          "id": "AC-010",
          "kind": "ac",
          "theme": "general",
          "text": "human/machine/sqlite 三写入点共享 `source_hash`、`projection_seq`、`transaction_id`；任一不一致必须标记 `drift` 并阻断 release pass。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260420T161102Z-f6d1",
          "verified_by_run_id": "review.accept",
          "accepted_at": "2026-04-20T16:11:37.569593+00:00",
