        },
        {
          "id": "AC-011",
          "kind": "ac",
          "theme": "general",
          "text": "人类文档通过 semantic leak lint：无技术标识泄漏，白名单词条必须附业务解释；不通过则 review/freeze 失败。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260420T161102Z-f6d1",
          "verified_by_run_id": "review.accept",
          "accepted_at": "2026-04-20T16:11:37.569593+00:00",
          "changed_in_revision": "R1",
