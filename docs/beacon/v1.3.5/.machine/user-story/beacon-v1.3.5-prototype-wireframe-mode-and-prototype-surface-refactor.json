        },
        {
          "id": "AC-003",
          "kind": "ac",
          "theme": "general",
          "text": "`beacon-prototype` 成为唯一 host-visible 原型子 skill，默认解释为 requirement-driven wireframe freeze。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260420T161102Z-f6d1",
          "verified_by_run_id": "review.accept",
          "accepted_at": "2026-04-20T16:11:37.569593+00:00",
