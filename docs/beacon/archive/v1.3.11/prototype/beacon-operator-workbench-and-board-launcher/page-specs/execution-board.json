    "page_intent_contract": {
      "why_this_page_exists": "先暴露当前运行状态、阻塞项与下一步动作，而不是先展示全量运行历史。",
      "decision_supported": "当前应继续、停止、重试，还是先进入恢复路径。",
      "must_show_first": [
        "当前状态",
        "当前阻塞"
