        }
      ]
    },
    "first_screen_contract": {
      "primary_status": "当前运行态完整，可执行继续、停止或重试。",
      "primary_blocker": "存在阻塞运行，必须优先判断恢复路径。",
      "next_actions": [
        "进入运行详情",
        "进入恢复诊断",
        "进入功能详情"
      ],
      "recovery_path": "优先进入恢复路径或返回上一层，不允许停留在无动作状态。",
      "secondary_disclosure_only": [
        "run list",
        "workspace path",
        "artifact path",
        "history timeline",
        "machine trace detail"
      ]
    },
    "review_principles": [
      "首屏先回答当前页最重要的问题。",
      "主体区只保留支撑判断的结构，不展开高保真视觉。"
    ],
    "layout_breakdown": [
      {
        "section": "当前状态",
        "purpose": "承载该页完成核心判断所需的最小信息块。",
        "display_zone": "首屏"
      },
      {
        "section": "当前阻塞",
        "purpose": "集中暴露异常与介入信号，避免风险被正常信息淹没。",
        "display_zone": "主体区"
      },
      {
        "section": "下一步动作",
        "purpose": "把观察收口成明确动作，避免用户看完后不知道去哪里。",
        "display_zone": "主体区"
      },
      {
        "section": "运行分组",
        "purpose": "只展示运行态必要信息，不展开底层机器细节。",
        "display_zone": "收口区"
      }
    ],
    "interaction_contract": [
      "- `进入运行详情`: 通过 点击运行项 进入 `run-detail`，把当前判断转交到下一层页面完成。",
      "- `进入恢复诊断`: 通过 点击阻塞或异常项 进入 `recovery-diagnostics`，把当前判断转交到下一层页面完成。",
      "- `进入功能详情`: 通过 点击 feature 关联 进入 `feature-detail`，把当前判断转交到下一层页面完成。"
    ],
    "state_contract": [
      "- `可用`: 当前运行态完整，可执行继续、停止或重试。",
      "- `阻塞`: 存在阻塞运行，必须优先判断恢复路径。",
      "- `待验收`: 存在待验收运行，需要进入验收面。",
      "- `已排队重试`: 存在待重试运行，需确认是否继续。",
      "- `加载中`: 运行状态仍在读取。 加载态只保留骨架结构，避免造成页面重新排版。",
      "- `错误`: 运行状态读取失败，必须暴露恢复路径。 页面要优先给出回退或恢复入口，而不是只报错。"
    ],
    "noise_guardrail": "首屏只保留操作者判断需要的信息；路径、历史与机器材料只能进入二级展开。"
  },
