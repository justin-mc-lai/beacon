        "machine trace detail"
      ]
    },
    "review_principles": [
      "首屏先回答当前页最重要的问题。",
      "主体区只保留支撑判断的结构，不展开高保真视觉。"
    ],
    "layout_breakdown": [
      {
        "section": "运行状态",
        "purpose": "只展示运行态必要信息，不展开底层机器细节。",
        "display_zone": "首屏"
      },
      {
        "section": "阻塞原因",
        "purpose": "集中暴露异常与介入信号，避免风险被正常信息淹没。",
        "display_zone": "主体区"
      },
      {
        "section": "建议动作",
        "purpose": "承载该页完成核心判断所需的最小信息块。",
        "display_zone": "主体区"
      },
      {
        "section": "二级明细",
        "purpose": "承载该页完成核心判断所需的最小信息块。",
        "display_zone": "收口区"
      }
    ],
    "interaction_contract": [
      "- `进入恢复诊断`: 通过 点击阻塞原因 进入 `recovery-diagnostics`，把当前判断转交到下一层页面完成。",
      "- `进入验收面`: 通过 点击验收入口 进入 `review-surface`，把当前判断转交到下一层页面完成。"
    ],
    "state_contract": [
      "- `运行中`: 当前运行仍在推进。",
      "- `阻塞`: 当前运行被阻断，必须优先判断恢复动作。",
      "- `待验收`: 当前运行等待验收。",
      "- `已排队重试`: 当前运行等待重试。",
      "- `错误`: 当前运行状态不一致，必须暴露恢复路径。 页面要优先给出回退或恢复入口，而不是只报错。"
    ],
    "noise_guardrail": "首屏只保留操作者判断需要的信息；路径、历史与机器材料只能进入二级展开。"
  },
