      "items": [
        {
          "id": "AC-001",
          "kind": "ac",
          "theme": "public-surface",
          "text": "v1.6.0 planner public surface 收敛为 `beacon-pln-brainstorm`、`beacon-pln-source`、`beacon-pln-review`、`beacon-pln-friction`。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260609T085810Z-ee0f",
          "verified_by_run_id": "run-20260610T112635321529",
          "accepted_at": "2026-06-10T03:26:51.774110+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.6.0/features/beacon-pln-review-intent-parity-state-machine-v160/truth.md"
        },
        {
          "id": "AC-002",
          "kind": "ac",
          "theme": "internal-reviewer-catalog",
          "text": "founder/security/performance/doubt/context/simplify/adr/design/deep 等过细 planner 能力进入 `beacon-pln-review` references/reviewer catalog，不作为默认 public route。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260610T112635321529",
          "accepted_at": "2026-06-10T03:26:51.774110+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.6.0/features/beacon-pln-review-intent-parity-state-machine-v160/truth.md"
        },
        {
          "id": "AC-003",
          "kind": "ac",
          "theme": "thin-skill",
          "text": "`beacon-pln-review/SKILL.md` 是薄入口，详细 reviewer、finding、artifact、state-machine 和 skill-package 规则进入直接引用的 `references/`。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260610T112635321529",
          "accepted_at": "2026-06-10T03:26:51.774110+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.6.0/features/beacon-pln-review-intent-parity-state-machine-v160/truth.md"
        },
        {
          "id": "AC-004",
          "kind": "ac",
          "theme": "boundary",
          "text": "`beacon-pln-review` 遵守 planner HARD GATE，不能写 truth、代码、`.machine/`、QA verdict 或 release verdict。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260610T112635321529",
          "accepted_at": "2026-06-10T03:26:51.774110+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.6.0/features/beacon-pln-review-intent-parity-state-machine-v160/truth.md"
        },
        {
          "id": "AC-005",
          "kind": "ac",
          "theme": "intent-fidelity",
          "text": "review artifact 必须保留 `intent_snapshot`，并识别强意图词，防止完整意图被静默弱化。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260610T112635321529",
          "accepted_at": "2026-06-10T03:26:51.774110+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.6.0/features/beacon-pln-review-intent-parity-state-machine-v160/truth.md"
        },
        {
          "id": "AC-006",
          "kind": "ac",
          "theme": "full-parity-default",
          "text": "用户说“完整复刻”“同等能力”“做全”或同类表达时，默认 `scope_mode=full_parity`。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260610T112635321529",
          "accepted_at": "2026-06-10T03:26:51.774110+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.6.0/features/beacon-pln-review-intent-parity-state-machine-v160/truth.md"
        },
        {
          "id": "AC-007",
          "kind": "ac",
          "theme": "source-parity",
          "text": "source 项目存在时，必须生成 `source_capability_inventory` 和 `parity_matrix`，否则不能 freeze/implement。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260610T112635321529",
          "accepted_at": "2026-06-10T03:26:51.774110+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.6.0/features/beacon-pln-review-intent-parity-state-machine-v160/truth.md"
        },
        {
          "id": "AC-008",
          "kind": "ac",
          "theme": "deferral-sovereignty",
          "text": "任何 MVP、延期、裁剪或未覆盖能力必须进入 `deferral_ledger` 并要求用户显式接受。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260610T112635321529",
          "accepted_at": "2026-06-10T03:26:51.774110+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.6.0/features/beacon-pln-review-intent-parity-state-machine-v160/truth.md"
        },
        {
          "id": "AC-009",
          "kind": "ac",
          "theme": "state-machine-reviewer",
          "text": "reviewer catalog 必须包含 `state-machine` reviewer，并在 lifecycle/workflow/loop/recovery/permission/source-parity 场景触发。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260610T112635321529",
          "accepted_at": "2026-06-10T03:26:51.774110+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.6.0/features/beacon-pln-review-intent-parity-state-machine-v160/truth.md"
        },
        {
          "id": "AC-010",
          "kind": "ac",
          "theme": "state-model-output",
          "text": "state-machine reviewer 必须输出 states、transitions、invalid transitions、side effects、recovery paths、terminal states、state axes 和 coverage implications。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260610T112635321529",
          "accepted_at": "2026-06-10T03:26:51.774110+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.6.0/features/beacon-pln-review-intent-parity-state-machine-v160/truth.md"
        },
        {
          "id": "AC-011",
          "kind": "ac",
          "theme": "truth-state-landing",
          "text": "package truth 必须支持 `State Model` / `Diagram Truth Layer` 落点；缺失时 route `beacon-gen-truth` 或 `beacon-gen-change`。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260610T112635321529",
          "accepted_at": "2026-06-10T03:26:51.774110+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.6.0/features/beacon-pln-review-intent-parity-state-machine-v160/truth.md"
        },
        {
          "id": "AC-012",
          "kind": "ac",
          "theme": "coverage-state-landing",
          "text": "package tests 必须覆盖状态转移、非法转移、恢复路径和状态轴组合。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260610T112635321529",
          "accepted_at": "2026-06-10T03:26:51.774110+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.6.0/features/beacon-pln-review-intent-parity-state-machine-v160/truth.md"
        },
        {
          "id": "AC-013",
          "kind": "ac",
          "theme": "research-support-boundary",
          "text": "research 中的状态机图/业务流图是 `support_advisory`；只有用户接受并存在 `promotion_ref` 后才能进入 truth/change。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260610T112635321529",
          "accepted_at": "2026-06-10T03:26:51.774110+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.6.0/features/beacon-pln-review-intent-parity-state-machine-v160/truth.md"
        },
        {
          "id": "AC-014",
          "kind": "ac",
          "theme": "finding-schema",
          "text": "所有 findings 必须包含 reviewer、severity、confidence、authority_level、evidence_refs、affected_truth_surface、recommended_route 和 user_decision_required。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260610T112635321529",
          "accepted_at": "2026-06-10T03:26:51.774110+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.6.0/features/beacon-pln-review-intent-parity-state-machine-v160/truth.md"
        },
        {
          "id": "AC-015",
          "kind": "ac",
          "theme": "no-autofix",
          "text": "planner findings 默认 `autofix_allowed=false`，不能由 planner 自动改 truth 或实现。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260610T112635321529",
          "accepted_at": "2026-06-10T03:26:51.774110+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:/Users/apple/Developer/Personal/products/beacon/docs/beacon/v1.6.0/features/beacon-pln-review-intent-parity-state-machine-v160/truth.md"
        },
        {
          "id": "AC-016",
          "kind": "ac",
          "theme": "route-synthesis",
          "text": "多 reviewer 输出必须 merge/dedup/synthesize 成单一 route recommendation，不能把多个 reviewer 的互斥结论直接丢给用户。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260610T112635321529",
          "accepted_at": "2026-06-10T03:26:51.774110+00:00",
          "changed_in_revision": "R1",
