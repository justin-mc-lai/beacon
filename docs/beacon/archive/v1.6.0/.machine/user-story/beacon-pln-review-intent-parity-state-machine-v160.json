        },
        {
          "id": "AC-017",
          "kind": "ac",
          "theme": "skill-creator-standard",
          "text": "Beacon public skills 必须符合 skill-creator anatomy：frontmatter、精简入口、直接 references、metadata/eval 约束。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": null,
          "verified_by_run_id": "run-20260610T112635321529",
          "accepted_at": "2026-06-10T03:26:51.774110+00:00",
