        },
        {
          "id": "AC-006",
          "kind": "ac",
          "theme": "no-stage-inflation",
          "text": "`beacon-truth` must not turn brainstorm, change-refreeze, QA, or release into truth authoring stages.",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
          "verified_by_run_id": null,
          "accepted_at": null,
          "changed_in_revision": null,
          "story_id": "",
          "details": [],
