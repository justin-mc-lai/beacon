          "kind": "ac",
          "theme": "coverage-boundary",
          "text": "Coverage truth remains in `features/<slug>/tests.md`; `truth.md` owns requirement and acceptance framing, not executable coverage matrices.",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
