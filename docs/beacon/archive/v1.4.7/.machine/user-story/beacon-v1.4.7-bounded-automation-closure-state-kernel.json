          "id": "AC-001",
          "kind": "ac",
          "theme": "Beacon 为 QA/implement repeated repair work 定义了 machine-readable closure-state envelope",
          "text": "Beacon defines a machine-readable closure-state envelope for feature-level bounded automation repair work, including current closure state, next route, terminal signal, round number, and previous-round reference.",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
