        },
        {
          "id": "AC-009",
          "kind": "ac",
          "theme": "general",
          "text": "Beacon provides operator-visible bounded runtime explanation for each round, including the current round number, closure state, terminal signal, next route, and whether human takeover is required.",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
