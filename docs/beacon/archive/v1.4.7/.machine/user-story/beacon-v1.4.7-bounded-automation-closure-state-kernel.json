        {
          "id": "AC-002",
          "kind": "ac",
          "theme": "Beacon 为 repeated repair round 定义了 active issue register inheritance contract",
          "text": "Beacon freezes a bounded closure-state taxonomy that can at minimum distinguish `active`, `blocked`, `release_ready`, `closed`, and `human_escalation_required`.",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
          "verified_by_run_id": null,
          "accepted_at": null,
          "changed_in_revision": null,
