          "details": [],
          "source": "user-story:docs/beacon/v1.4.7/user-story/beacon-v1.4.7-bounded-automation-closure-state-kernel.md"
        },
        {
          "id": "AC-008",
          "kind": "ac",
          "theme": "automation runtime 不具备 truth-moving authority，也不宣传 full autonomous closure-loop",
          "text": "Beacon adds feature-level execution lease semantics so only one automation worker can actively claim the same feature at one time.",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
          "verified_by_run_id": null,
          "accepted_at": null,
          "changed_in_revision": null,
