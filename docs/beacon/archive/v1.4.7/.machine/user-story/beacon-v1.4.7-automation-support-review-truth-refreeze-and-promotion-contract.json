          "id": "AC-001",
          "kind": "ac",
          "theme": "general",
          "text": "Beacon can emit `next_route=support_review` with explicit executor and reason metadata when QA or automation determines that repeated structural failure needs a support surface rather than immediate implement retry.",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
