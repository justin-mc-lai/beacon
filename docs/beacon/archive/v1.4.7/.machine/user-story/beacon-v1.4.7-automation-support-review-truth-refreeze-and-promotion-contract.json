        },
        {
          "id": "AC-002",
          "kind": "ac",
          "theme": "general",
          "text": "Beacon can record bounded `deep` outcomes that distinguish implementation-only findings, truth-pressure findings, and repeat-cap exhaustion.",
          "required": true,
          "status": "draft",
          "implemented_by_run_id": null,
          "verified_by_run_id": null,
          "accepted_at": null,
          "changed_in_revision": null,
