  "stories": [
    {
      "story_id": "US-001",
      "revision_id": "R1",
      "title": "Beacon v1.3.2 implement / qa execution modes",
      "priority": "high",
      "status": "accepted",
      "items": [
        {
          "id": "AC-001",
          "kind": "ac",
          "theme": "implement-single",
          "text": "`implement` must support explicit single mode for code implementation, run in a single process, avoid team worker lanes and tmux HUD, and still continue to formal review, qa, and gate.",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260416T030652Z-900b",
          "verified_by_run_id": "review.accept",
          "accepted_at": "2026-04-16T07:05:37.397308+00:00",
          "changed_in_revision": "R1",
          "story_id": "US-001",
          "details": [],
          "source": "user-story:machine-sync"
        },
        {
          "id": "AC-002",
          "kind": "ac",
          "theme": "implement-team",
          "text": "`implement` must support explicit team mode, enter a bounded multi-agent runtime, produce role reports, worker evidence, tmux panes, and HUD, while keeping canonical writeback owned by Beacon stage owner.",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260416T030652Z-900b",
          "verified_by_run_id": "review.accept",
          "accepted_at": "2026-04-16T07:05:37.397308+00:00",
          "changed_in_revision": "R1",
          "story_id": "US-002",
          "details": [],
          "source": "user-story:machine-sync"
        },
        {
          "id": "AC-003",
          "kind": "ac",
          "theme": "ralph-closure",
          "text": "`ralph` must operate only around the implement plus qa closure, must not rewrite frozen prd, user-story, or test-case materials directly, and must expose explicit stop states.",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260416T030652Z-900b",
          "verified_by_run_id": "review.accept",
          "accepted_at": "2026-04-16T07:05:37.397308+00:00",
          "changed_in_revision": "R1",
          "story_id": "US-003",
          "details": [],
          "source": "user-story:machine-sync"
        },
        {
          "id": "AC-004",
          "kind": "ac",
          "theme": "qa-execution-plane",
          "text": "`qa` must act as the second execution plane after implement, covering browser acceptance, boundary discovery, structure inference, and repair handoff instead of a one-shot trailing test pass.",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260416T030652Z-900b",
          "verified_by_run_id": "review.accept",
          "accepted_at": "2026-04-16T07:05:37.397308+00:00",
          "changed_in_revision": "R1",
          "story_id": "US-004",
          "details": [],
          "source": "user-story:machine-sync"
        },
        {
          "id": "AC-005",
          "kind": "ac",
          "theme": "frozen-input-order",
          "text": "`qa` must execute in frozen material order, reading frozen prd, frozen user-story, and frozen test-case before browser scenarios, and must not expand scope beyond those frozen inputs.",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260416T030652Z-900b",
          "verified_by_run_id": "review.accept",
          "accepted_at": "2026-04-16T07:05:37.397308+00:00",
          "changed_in_revision": "R1",
          "story_id": "US-005",
          "details": [],
          "source": "user-story:machine-sync"
        },
        {
          "id": "AC-006",
          "kind": "ac",
          "theme": "browser-family",
          "text": "`qa` must launch a real browser environment for the target project and support a browser execution family that includes browser-cli, agent-browser, pageagent, and browser-use for page and flow validation.",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260416T030652Z-900b",
          "verified_by_run_id": "review.accept",
          "accepted_at": "2026-04-16T07:05:37.397308+00:00",
          "changed_in_revision": "R1",
          "story_id": "US-006",
          "details": [],
          "source": "user-story:machine-sync"
        },
        {
          "id": "AC-007",
          "kind": "ac",
          "theme": "iterative-qa",
          "text": "`qa` must support ordered, multi-round browser scenario execution where each round can reprioritize the next set of browser checks based on the previous round findings.",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260416T030652Z-900b",
          "verified_by_run_id": "review.accept",
          "accepted_at": "2026-04-16T07:05:37.397308+00:00",
          "changed_in_revision": "R1",
          "story_id": "US-007",
          "details": [],
          "source": "user-story:machine-sync"
        },
        {
          "id": "AC-008",
          "kind": "ac",
          "theme": "auto-research-delta",
          "text": "Every qa round must add new auto research value such as a new browser boundary, a new page state, a new exception path, a new coverage closure, or a new repair handoff.",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260416T030652Z-900b",
          "verified_by_run_id": "review.accept",
          "accepted_at": "2026-04-16T07:05:37.397308+00:00",
          "changed_in_revision": "R1",
          "story_id": "US-008",
          "details": [],
          "source": "user-story:machine-sync"
        },
        {
          "id": "AC-009",
          "kind": "ac",
          "theme": "boundary-feedback",
          "text": "Each qa round must output boundary feedback, flow or page structure inference, uncovered scope notes, and feed that evidence into repair handoff or the next Ralph decision.",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260416T030652Z-900b",
          "verified_by_run_id": "review.accept",
          "accepted_at": "2026-04-16T07:05:37.397308+00:00",
          "changed_in_revision": "R1",
          "story_id": "US-009",
          "details": [],
          "source": "user-story:machine-sync"
        },
        {
          "id": "AC-010",
          "kind": "ac",
          "theme": "product-polish-loop",
          "text": "Multi-round qa must progressively polish functional correctness, browser acceptance path completeness, and product boundary clarity instead of replaying the same page script without learning.",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260416T030652Z-900b",
          "verified_by_run_id": "review.accept",
          "accepted_at": "2026-04-16T07:05:37.397308+00:00",
          "changed_in_revision": "R1",
          "story_id": "US-009",
          "details": [],
          "source": "user-story:machine-sync"
        },
        {
          "id": "AC-011",
          "kind": "ac",
          "theme": "ralph-stop-states",
          "text": "`ralph` must support at least release_ready, human_blocked, and budget_exhausted stop states and decide continuation only from formal implement, qa, and gate outputs.",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260416T030652Z-900b",
          "verified_by_run_id": "review.accept",
          "accepted_at": "2026-04-16T07:05:37.397308+00:00",
          "changed_in_revision": "R1",
          "story_id": "US-003",
          "details": [],
          "source": "user-story:machine-sync"
        },
        {
          "id": "AC-012",
          "kind": "ac",
          "theme": "observability",
          "text": "`status` and `help` must display the current mode, current round, current browser runner or executor, current blocker, and recommended next step for the active implement or qa loop.",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260416T030652Z-900b",
          "verified_by_run_id": "review.accept",
          "accepted_at": "2026-04-16T07:05:37.397308+00:00",
          "changed_in_revision": "R1",
          "story_id": "US-010",
          "details": [],
          "source": "user-story:machine-sync"
        },
        {
          "id": "AC-013",
          "kind": "ac",
          "theme": "minimal-human-surface",
          "text": "`v1.3.2` must continue the minimal human workflow and keep `prd -> user-story -> test-case -> implement -> qa -> release` as the stable public cognitive loop.",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260416T030652Z-900b",
          "verified_by_run_id": "review.accept",
          "accepted_at": "2026-04-16T07:05:37.397308+00:00",
          "changed_in_revision": "R1",
          "story_id": "US-011",
          "details": [],
          "source": "user-story:machine-sync"
        },
        {
          "id": "AC-014",
          "kind": "ac",
          "theme": "no-new-public-team-surface",
          "text": "`v1.3.2` must not add new public top-level commands that force humans to operate team, subagent, or precheck flows directly.",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260416T030652Z-900b",
          "verified_by_run_id": "review.accept",
          "accepted_at": "2026-04-16T07:05:37.397308+00:00",
          "changed_in_revision": "R1",
          "story_id": "US-011",
          "details": [],
          "source": "user-story:machine-sync"
        },
        {
          "id": "AC-015",
          "kind": "ac",
          "theme": "host-native-subagents",
          "text": "When Beacon runs as a skill inside Codex or Claude, it must use the host-native subagent or team capability instead of bridging another external executor; `omx` remains a design reference only.",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260416T030652Z-900b",
          "verified_by_run_id": "review.accept",
          "accepted_at": "2026-04-16T07:05:37.397308+00:00",
          "changed_in_revision": "R1",
          "story_id": "US-012",
          "details": [],
          "source": "user-story:machine-sync"
        },
        {
          "id": "AC-016",
          "kind": "ac",
          "theme": "embedded-prechecks",
          "text": "`runtime-readiness` and `delegation-readiness` prechecks must be embedded into `implement` and `qa` by default and must not become extra daily commands that humans need to remember.",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260416T030652Z-900b",
          "verified_by_run_id": "review.accept",
          "accepted_at": "2026-04-16T07:05:37.397308+00:00",
          "changed_in_revision": "R1",
          "story_id": "US-013",
          "details": [],
          "source": "user-story:machine-sync"
        },
        {
          "id": "AC-017",
          "kind": "ac",
          "theme": "minimal-human-output",
          "text": "Precheck, delegation, and blocker decisions must expose minimal human-facing output while preserving detailed machine-readable diagnostics for automation and audit.",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260416T030652Z-900b",
          "verified_by_run_id": "review.accept",
          "accepted_at": "2026-04-16T07:05:37.397308+00:00",
          "changed_in_revision": "R1",
          "story_id": "US-013",
          "details": [],
          "source": "user-story:machine-sync"
        },
        {
          "id": "AC-018",
          "kind": "ac",
          "theme": "unique-host-context",
          "text": "`v1.3.2` must treat the current host context as unique and only decide whether the active host supports native subagent or team capability; it must not introduce multi-runtime bridge or selection semantics.",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260416T030652Z-900b",
          "verified_by_run_id": "review.accept",
          "accepted_at": "2026-04-16T07:05:37.397308+00:00",
          "changed_in_revision": "R1",
          "story_id": "US-014",
          "details": [],
          "source": "user-story:machine-sync"
        },
        {
          "id": "AC-019",
          "kind": "ac",
          "theme": "canonical-global-boundaries",
          "text": "Beacon must expose one canonical global-boundaries source that every version line inherits, references, and implements without inventing a competing global truth.",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260416T030652Z-900b",
          "verified_by_run_id": "review.accept",
          "accepted_at": "2026-04-16T07:05:37.397308+00:00",
          "changed_in_revision": "R1",
          "story_id": "US-015",
          "details": [],
          "source": "user-story:machine-sync"
        },
        {
          "id": "AC-020",
          "kind": "ac",
          "theme": "source-dev-support",
          "text": "Beacon source development itself must be constrained and verifiable by global-boundaries across docs layout, host-visible skill exposure, and public command surfaces.",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260416T030652Z-900b",
          "verified_by_run_id": "review.accept",
          "accepted_at": "2026-04-16T07:05:37.397308+00:00",
          "changed_in_revision": "R1",
          "story_id": "US-016",
          "details": [],
          "source": "user-story:machine-sync"
        },
        {
          "id": "AC-021",
          "kind": "ac",
          "theme": "target-project-support",
          "text": "Target projects using Beacon must be able to sense, inherit, and verify global-boundaries through managed context, AGENTS.md, CLAUDE.md, and project-side command semantics.",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260416T030652Z-900b",
          "verified_by_run_id": "review.accept",
          "accepted_at": "2026-04-16T07:05:37.397308+00:00",
          "changed_in_revision": "R1",
          "story_id": "US-017",
          "details": [],
          "source": "user-story:machine-sync"
        },
        {
          "id": "AC-022",
          "kind": "ac",
          "theme": "init-and-context-support",
          "text": "`init`, `doctor setup-context`, `doctor verify-context`, and `doctor sync-materials` must establish, validate, and sync the visible inheritance of global-boundaries.",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260416T030652Z-900b",
          "verified_by_run_id": "review.accept",
          "accepted_at": "2026-04-16T07:05:37.397308+00:00",
          "changed_in_revision": "R1",
          "story_id": "US-018",
          "details": [],
          "source": "user-story:machine-sync"
        },
        {
          "id": "AC-023",
          "kind": "ac",
          "theme": "version-inheritance-declared",
          "text": "Every Beacon version package must explicitly declare how it inherits, references, and realizes global-boundaries without presenting version-local boundaries as new global truth.",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260416T030652Z-900b",
          "verified_by_run_id": "review.accept",
          "accepted_at": "2026-04-16T07:05:37.397308+00:00",
          "changed_in_revision": "R1",
          "story_id": "US-019",
          "details": [],
          "source": "user-story:machine-sync"
        },
        {
          "id": "AC-024",
          "kind": "ac",
          "theme": "delivery-loop-compliance",
          "text": "A target project's `prd -> user-story -> test-case -> implement -> qa -> release` loop must be verifiably compliant with global-boundaries while keeping the human workflow minimal.",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260416T030652Z-900b",
          "verified_by_run_id": "review.accept",
          "accepted_at": "2026-04-16T07:05:37.397308+00:00",
          "changed_in_revision": "R1",
          "story_id": "US-020",
          "details": [],
          "source": "user-story:machine-sync"
        },
        {
          "id": "AC-025",
          "kind": "ac",
          "theme": "doctor-global-boundaries-drift",
          "text": "`doctor` must detect and report global-boundaries drift between the Beacon source package and the target project's inherited context.",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260416T030652Z-900b",
          "verified_by_run_id": "review.accept",
          "accepted_at": "2026-04-16T07:05:37.397308+00:00",
          "changed_in_revision": "R1",
          "story_id": "US-021",
          "details": [],
          "source": "user-story:machine-sync"
        },
        {
          "id": "AC-026",
          "kind": "ac",
          "theme": "success-includes-global-boundaries",
          "text": "`v1.3.2` success criteria must include verifiable support for global-boundaries on both the Beacon source side and the target-project side.",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260416T030652Z-900b",
