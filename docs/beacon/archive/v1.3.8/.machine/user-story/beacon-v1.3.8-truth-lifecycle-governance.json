          "details": [],
          "source": "user-story:docs/beacon/v1.3.8/user-story/beacon-v1.3.8-truth-lifecycle-governance.md"
        },
        {
          "id": "AC-002",
          "kind": "ac",
          "theme": "diagram-truth",
          "text": "复杂业务 feature 的 PRD 可以正式承载 branch-flow、state-machine、decision-priority 和 state axis，不再只依赖叙述型文本。",
          "required": true,
          "status": "implemented",
          "implemented_by_run_id": "run-20260424T104500Z-v138-truth-lifecycle",
          "verified_by_run_id": null,
          "accepted_at": null,
          "changed_in_revision": "R1",
