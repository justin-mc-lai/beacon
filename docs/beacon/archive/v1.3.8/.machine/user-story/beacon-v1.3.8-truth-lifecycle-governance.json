          "kind": "ac",
          "theme": "phase-projection",
          "text": "`status` / HUD 能明确显示当前处于 freeze、team、ralph 哪一阶段，以及 `stop_state` / `next_action`。",
          "required": true,
          "status": "implemented",
          "implemented_by_run_id": "run-20260424T104500Z-v138-truth-lifecycle",
          "verified_by_run_id": null,
