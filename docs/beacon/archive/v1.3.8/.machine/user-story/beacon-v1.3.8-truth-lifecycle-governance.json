        {
          "id": "AC-001",
          "kind": "ac",
          "theme": "version-theme",
          "text": "`v1.3.8` requirement package 明确表达 `truth admission -> truth execution -> truth retirement` 的版本级治理主题。",
          "required": true,
          "status": "implemented",
          "implemented_by_run_id": "run-20260424T104500Z-v138-truth-lifecycle",
          "verified_by_run_id": null,
          "accepted_at": null,
