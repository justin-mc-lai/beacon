        },
        {
          "id": "AC-003",
          "kind": "ac",
          "theme": "freeze-readiness",
          "text": "在 freeze 前，系统能判断某个 feature 是否因缺少 diagram truth layer 而不适合继续冻结。",
          "required": true,
          "status": "implemented",
          "implemented_by_run_id": "run-20260424T104500Z-v138-truth-lifecycle",
          "verified_by_run_id": null,
          "accepted_at": null,
          "changed_in_revision": "R1",
