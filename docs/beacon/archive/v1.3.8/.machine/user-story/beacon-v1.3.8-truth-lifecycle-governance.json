        },
        {
          "id": "AC-004",
          "kind": "ac",
          "theme": "execution-sequence",
          "text": "冻结后的 `team -> ralph` 顺序可以被 Beacon 公开表达为正式 execution contract。",
          "required": true,
          "status": "implemented",
          "implemented_by_run_id": "run-20260424T104500Z-v138-truth-lifecycle",
          "verified_by_run_id": null,
