  "stories": [
    {
      "story_id": "US-001",
      "revision_id": "R1",
      "title": "beacon-v1.3.12-host-llm-requirement-deepening-and-human-loop-closure",
      "priority": "medium",
      "status": "accepted",
      "items": [
        {
          "id": "AC-001",
          "kind": "ac",
          "theme": "requirement-envelope",
          "text": "Beacon 能围绕单份 PRD 结构化生成 `actors / capability_differences / state_machine / happy_paths / negative_paths / boundary_conditions / exceptions / recovery_paths / risks / open_questions` 十类 requirement 维度。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260506T012437Z-2ed7",
          "verified_by_run_id": "run-20260506T092640341315",
          "accepted_at": "2026-05-06T01:28:08.331037+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:docs/beacon/v1.3.12/user-story/beacon-v1.3.12-host-llm-requirement-deepening-and-human-loop-closure.md"
        },
        {
          "id": "AC-002",
          "kind": "ac",
          "theme": "prd-anchored-inference",
          "text": "envelope 的所有推导都必须绑定明确 `source_truth_ref`，证明其来源于当前 PRD 或同 feature 已冻结 requirement materials，而不是脱离 truth 的自由扩写。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260506T012437Z-2ed7",
          "verified_by_run_id": "run-20260506T092640341315",
          "accepted_at": "2026-05-06T01:28:08.331037+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:docs/beacon/v1.3.12/user-story/beacon-v1.3.12-host-llm-requirement-deepening-and-human-loop-closure.md"
        },
        {
          "id": "AC-003",
          "kind": "ac",
          "theme": "machine-readable-envelope",
          "text": "deepening envelope 必须落为 machine-readable artifact，并可被 `user-story / test-case / delivery completeness` 读取。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260506T012437Z-2ed7",
          "verified_by_run_id": "run-20260506T092640341315",
          "accepted_at": "2026-05-06T01:28:08.331037+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:docs/beacon/v1.3.12/user-story/beacon-v1.3.12-host-llm-requirement-deepening-and-human-loop-closure.md"
        },
        {
          "id": "AC-004",
          "kind": "ac",
          "theme": "envelope-not-public-stage",
          "text": "envelope 是 requirement compile 的内部推导面，不新增新的公开 lifecycle stage，也不要求人类长期理解内部 runtime 细节。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260506T012437Z-2ed7",
          "verified_by_run_id": "run-20260506T092640341315",
          "accepted_at": "2026-05-06T01:28:08.331037+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:docs/beacon/v1.3.12/user-story/beacon-v1.3.12-host-llm-requirement-deepening-and-human-loop-closure.md"
        },
        {
          "id": "AC-005",
          "kind": "ac",
          "theme": "story-discovery",
          "text": "`user-story` 至少能发现主角色目标故事、次角色/对立角色能力差异故事、状态转换故事、异常恢复故事、权限/约束差异故事、治理补充故事六类 candidate。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260506T012437Z-2ed7",
          "verified_by_run_id": "run-20260506T092640341315",
          "accepted_at": "2026-05-06T01:28:08.331037+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:docs/beacon/v1.3.12/user-story/beacon-v1.3.12-host-llm-requirement-deepening-and-human-loop-closure.md"
        },
        {
          "id": "AC-006",
          "kind": "ac",
          "theme": "story-candidate-status",
          "text": "每个 story candidate 至少要区分 `already_frozen / candidate_missing / deferred / rejected` 四类状态，而不是只给出一份匿名建议清单。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260506T012437Z-2ed7",
          "verified_by_run_id": "run-20260506T092640341315",
          "accepted_at": "2026-05-06T01:28:08.331037+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:docs/beacon/v1.3.12/user-story/beacon-v1.3.12-host-llm-requirement-deepening-and-human-loop-closure.md"
        },
        {
          "id": "AC-007",
          "kind": "ac",
          "theme": "not-just-ac-reprojection",
          "text": "对至少一个真实 feature，`user-story` 必须能证明自己产出的新增候选不只是复述当前 markdown 中已有 AC 文本。",
          "required": true,
          "status": "accepted",
          "implemented_by_run_id": "run-20260506T012437Z-2ed7",
          "verified_by_run_id": "run-20260506T092640341315",
          "accepted_at": "2026-05-06T01:28:08.331037+00:00",
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:docs/beacon/v1.3.12/user-story/beacon-v1.3.12-host-llm-requirement-deepening-and-human-loop-closure.md"
        },
        {
          "id": "AC-008",
          "kind": "ac",
          "theme": "story-writeback-target",
          "text": "当人类接受某个 story candidate 后，系统必须明确把它写回到 `story boundary / acceptance criteria / metadata scope` 中的正确位置。",
          "required": true,
          "status": "verified",
          "implemented_by_run_id": "run-20260506T012437Z-2ed7",
          "verified_by_run_id": "run-20260506T012437Z-2ed7-tester",
          "accepted_at": null,
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:docs/beacon/v1.3.12/user-story/beacon-v1.3.12-host-llm-requirement-deepening-and-human-loop-closure.md"
        },
        {
          "id": "AC-009",
          "kind": "ac",
          "theme": "risk-coverage-families",
          "text": "`test-case` 至少显式评估并展开 `happy / negative / boundary / exception / recovery / compatibility / permission / stale-data-or-drift / downgrade-or-fallback` 九类覆盖族群。",
          "required": true,
          "status": "verified",
          "implemented_by_run_id": "run-20260506T012437Z-2ed7",
          "verified_by_run_id": "run-20260506T012437Z-2ed7-tester",
          "accepted_at": null,
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:docs/beacon/v1.3.12/user-story/beacon-v1.3.12-host-llm-requirement-deepening-and-human-loop-closure.md"
        },
        {
          "id": "AC-010",
          "kind": "ac",
          "theme": "traceable-coverage-rationale",
          "text": "每一类新增 coverage candidate 都必须带 `source_truth_ref / rationale / risk_family / writeback_target`，说明为什么要测。",
          "required": true,
          "status": "verified",
          "implemented_by_run_id": "run-20260506T012437Z-2ed7",
          "verified_by_run_id": "run-20260506T012437Z-2ed7-tester",
          "accepted_at": null,
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:docs/beacon/v1.3.12/user-story/beacon-v1.3.12-host-llm-requirement-deepening-and-human-loop-closure.md"
        },
        {
          "id": "AC-011",
          "kind": "ac",
          "theme": "beyond-default-matrix",
          "text": "对至少一个真实 feature，`test-case` 必须能证明自己补出的覆盖项不只是默认 `AC -> TC` 机械映射。",
          "required": true,
          "status": "verified",
          "implemented_by_run_id": "run-20260506T012437Z-2ed7",
          "verified_by_run_id": "run-20260506T012437Z-2ed7-tester",
          "accepted_at": null,
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:docs/beacon/v1.3.12/user-story/beacon-v1.3.12-host-llm-requirement-deepening-and-human-loop-closure.md"
        },
        {
          "id": "AC-012",
          "kind": "ac",
          "theme": "executable-coverage-writeback",
          "text": "人类接受某个 coverage candidate 后，系统必须能把它写回正式 `qa/test-cases` 文档及对应 machine coverage artifact。",
          "required": true,
          "status": "verified",
          "implemented_by_run_id": "run-20260506T012437Z-2ed7",
          "verified_by_run_id": "run-20260506T012437Z-2ed7-tester",
          "accepted_at": null,
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:docs/beacon/v1.3.12/user-story/beacon-v1.3.12-host-llm-requirement-deepening-and-human-loop-closure.md"
        },
        {
          "id": "AC-013",
          "kind": "ac",
          "theme": "supplement-contract",
          "text": "三个 public subskill 至少共享一套 `gap discovery -> human decision -> writeback target -> audit trail` 的补齐协议。",
          "required": true,
          "status": "verified",
          "implemented_by_run_id": "run-20260506T012437Z-2ed7",
          "verified_by_run_id": "run-20260506T012437Z-2ed7-tester",
          "accepted_at": null,
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:docs/beacon/v1.3.12/user-story/beacon-v1.3.12-host-llm-requirement-deepening-and-human-loop-closure.md"
        },
        {
          "id": "AC-014",
          "kind": "ac",
          "theme": "stage-appropriate-routing",
          "text": "PRD-level gap 可以被上游 story/test-case 面引用，但最终写回位置必须明确落在 PRD、Story 或 Test Case 的正确层，而不是任意追加。",
          "required": true,
          "status": "verified",
          "implemented_by_run_id": "run-20260506T012437Z-2ed7",
          "verified_by_run_id": "run-20260506T012437Z-2ed7-tester",
          "accepted_at": null,
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:docs/beacon/v1.3.12/user-story/beacon-v1.3.12-host-llm-requirement-deepening-and-human-loop-closure.md"
        },
        {
          "id": "AC-015",
          "kind": "ac",
          "theme": "decision-spectrum",
          "text": "人类对候选 requirement 的处理至少支持 `accepted / rejected / deferred` 三类决定，并要求记录原因。",
          "required": true,
          "status": "verified",
          "implemented_by_run_id": "run-20260506T012437Z-2ed7",
          "verified_by_run_id": "run-20260506T012437Z-2ed7-tester",
          "accepted_at": null,
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:docs/beacon/v1.3.12/user-story/beacon-v1.3.12-host-llm-requirement-deepening-and-human-loop-closure.md"
        },
        {
          "id": "AC-016",
          "kind": "ac",
          "theme": "no-silent-manual-patch",
          "text": "人类补齐 requirement 后，系统必须留下 machine-readable decision log，而不是允许 story/test-case 只在 markdown 里静默手工修改。",
          "required": true,
          "status": "verified",
          "implemented_by_run_id": "run-20260506T012437Z-2ed7",
          "verified_by_run_id": "run-20260506T012437Z-2ed7-tester",
          "accepted_at": null,
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:docs/beacon/v1.3.12/user-story/beacon-v1.3.12-host-llm-requirement-deepening-and-human-loop-closure.md"
        },
        {
          "id": "AC-017",
          "kind": "ac",
          "theme": "candidate-ledger-fields",
          "text": "candidate ledger 至少记录 `gap_id / gap_type / source_truth_ref / candidate_kind / candidate_payload / rationale / confidence / human_decision / writeback_target / resolved_at`。",
          "required": true,
          "status": "verified",
          "implemented_by_run_id": "run-20260506T012437Z-2ed7",
          "verified_by_run_id": "run-20260506T012437Z-2ed7-tester",
          "accepted_at": null,
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:docs/beacon/v1.3.12/user-story/beacon-v1.3.12-host-llm-requirement-deepening-and-human-loop-closure.md"
        },
        {
          "id": "AC-018",
          "kind": "ac",
          "theme": "revision-transaction-binding",
          "text": "当候选被接受并写回 formal truth 时，系统必须能把该决定绑定到 `revision_id / source_hash / transaction_id`，避免后续 re-freeze 无法判断属于哪一轮 truth。",
          "required": true,
          "status": "verified",
          "implemented_by_run_id": "run-20260506T012437Z-2ed7",
          "verified_by_run_id": "run-20260506T012437Z-2ed7-tester",
          "accepted_at": null,
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:docs/beacon/v1.3.12/user-story/beacon-v1.3.12-host-llm-requirement-deepening-and-human-loop-closure.md"
        },
        {
          "id": "AC-019",
          "kind": "ac",
          "theme": "anti-drift-preserved",
          "text": "human-loop 补齐后的 requirement package 仍必须满足 machine mirror 重投影、stale mirror 可审计、断裂时 fail-closed 的 anti-drift 规则。",
          "required": true,
          "status": "verified",
          "implemented_by_run_id": "run-20260506T012437Z-2ed7",
          "verified_by_run_id": "run-20260506T012437Z-2ed7-tester",
          "accepted_at": null,
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:docs/beacon/v1.3.12/user-story/beacon-v1.3.12-host-llm-requirement-deepening-and-human-loop-closure.md"
        },
        {
          "id": "AC-020",
          "kind": "ac",
          "theme": "future-rounds-queryable",
          "text": "被 rejected 或 deferred 的 candidate 不得消失在聊天历史中，而必须保留为未来 requirement round 可查询对象。",
          "required": true,
          "status": "verified",
          "implemented_by_run_id": "run-20260506T012437Z-2ed7",
          "verified_by_run_id": "run-20260506T012437Z-2ed7-tester",
          "accepted_at": null,
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:docs/beacon/v1.3.12/user-story/beacon-v1.3.12-host-llm-requirement-deepening-and-human-loop-closure.md"
        },
        {
          "id": "AC-021",
          "kind": "ac",
          "theme": "completeness-read-model",
          "text": "delivery layer 至少能读取 `unresolved_gap_count / high-risk unresolved categories / downgrade-fallback status / role-state-risk coverage completeness`。",
          "required": true,
          "status": "verified",
          "implemented_by_run_id": "run-20260506T012437Z-2ed7",
          "verified_by_run_id": "run-20260506T012437Z-2ed7-tester",
          "accepted_at": null,
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:docs/beacon/v1.3.12/user-story/beacon-v1.3.12-host-llm-requirement-deepening-and-human-loop-closure.md"
        },
        {
          "id": "AC-022",
          "kind": "ac",
          "theme": "readiness-verdict",
          "text": "系统必须明确 requirement completeness 的至少三种 verdict：`pass / pass_with_downgrade / blocked`。",
          "required": true,
          "status": "verified",
          "implemented_by_run_id": "run-20260506T012437Z-2ed7",
          "verified_by_run_id": "run-20260506T012437Z-2ed7-tester",
          "accepted_at": null,
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:docs/beacon/v1.3.12/user-story/beacon-v1.3.12-host-llm-requirement-deepening-and-human-loop-closure.md"
        },
        {
          "id": "AC-023",
          "kind": "ac",
          "theme": "deterministic-blocking",
          "text": "对于 high-severity unresolved gaps、不可接受的 host downgrade、或关键 coverage family 缺失，delivery layer 必须能解释为什么当前不够 `freeze-ready / implement-ready / release-ready`。",
          "required": true,
          "status": "verified",
          "implemented_by_run_id": "run-20260506T012437Z-2ed7",
          "verified_by_run_id": "run-20260506T012437Z-2ed7-tester",
          "accepted_at": null,
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:docs/beacon/v1.3.12/user-story/beacon-v1.3.12-host-llm-requirement-deepening-and-human-loop-closure.md"
        },
        {
          "id": "AC-024",
          "kind": "ac",
          "theme": "no-delivery-truth-rewrite",
          "text": "delivery layer 可以读取 completeness、报告 risk、触发回流，但不得绕过 `prd / user-story / test-case` 主链自行改写 requirement truth。",
          "required": true,
          "status": "verified",
          "implemented_by_run_id": "run-20260506T012437Z-2ed7",
          "verified_by_run_id": "run-20260506T012437Z-2ed7-tester",
          "accepted_at": null,
          "changed_in_revision": "R1",
          "story_id": "",
          "details": [],
          "source": "user-story:docs/beacon/v1.3.12/user-story/beacon-v1.3.12-host-llm-requirement-deepening-and-human-loop-closure.md"
        },
        {
          "id": "AC-025",
          "kind": "ac",
          "theme": "general",
          "text": "host-native 与 fallback 路径可区分",
          "required": true,
