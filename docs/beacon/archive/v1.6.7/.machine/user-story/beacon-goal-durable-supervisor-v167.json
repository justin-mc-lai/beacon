        "sections": {
          "architecture": [
            "No second public entry; supervise is a **sub-command** of goal.",
            "Authority: scorecards/verifier for complete; logs/FTS are support_advisory only.",
            "zvec is **not** architecture core (optional P2 later)."
          ],
          "business_flow": [
            "User: `beacon goal run \"...\"` → GoalRun `created/running` (no auto supervise).",
            "Optional: `beacon goal supervise --run-id` → SupervisorSession `active` (interval default 120s).",
            "Implement/QA work + `heartbeat` / auto heartbeat on interval.",
            "Host interrupt or idle stall → `host_interrupted` + checkpoint frozen.",
            "User/agent: `resume-pack` → continue `last_substep` / `next_action`.",
            "`tick --execute` may dispatch qa/ralph for current stage.",
            "Attach verifier → `complete` (never without refs).",
            "Release remains human confirmation.",
            "--"
          ]
        },
