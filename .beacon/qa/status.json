  "story_sequence": [
    {
      "ac_id": "AC-001",
      "theme": "topology-kind",
      "text": "Beacon 能持久化项目拓扑类型，至少区分 `single_repo` 与 `monorepo`。",
      "tc_ids": [
        "TC-001",
        "TC-045"
      ],
      "qa_types": [
        "interface",
        "unit"
      ]
    },
    {
      "ac_id": "AC-002",
      "theme": "service-bindings",
      "text": "当项目为 monorepo 时，Beacon 能持久化 `project_root -> service repo roots`、service key、角色与可写性边界。",
      "tc_ids": [
        "TC-002",
        "TC-046"
      ],
      "qa_types": [
        "contract",
        "unit"
      ]
    },
    {
      "ac_id": "AC-003",
      "theme": "deterministic-resolution",
      "text": "当元信息已存在时，Beacon 执行前能直接确定目标 service repo，而不是重新探测。",
      "tc_ids": [
        "TC-003",
        "TC-047"
      ],
      "qa_types": [
        "integration",
        "unit"
      ]
    },
    {
      "ac_id": "AC-004",
      "theme": "version-contract",
      "text": "Beacon 能为某个版本保存参与交付的 service set。",
      "tc_ids": [
        "TC-041"
      ],
      "qa_types": [
        "unit"
      ]
    },
    {
      "ac_id": "AC-005",
      "theme": "working-branch",
      "text": "Beacon 能为每个参与 service 保存该版本线对应的 allowed working branch contract。",
      "tc_ids": [
        "TC-042"
      ],
      "qa_types": [
        "unit"
      ]
    },
    {
      "ac_id": "AC-006",
      "theme": "minimal-branch-guard",
      "text": "Beacon 只表达最小 working-branch guard 与违例处理策略，不扩张为完整项目 Git workflow。",
      "tc_ids": [
        "TC-043"
      ],
      "qa_types": [
        "unit"
      ]
    },
    {
      "ac_id": "AC-007",
      "theme": "two-layer-model",
      "text": "Beacon 明确把 metadata 拆成“全局项目级元信息”和“版本级元信息”两层，而不是把所有字段混成单层模型。",
      "tc_ids": [
        "TC-044"
      ],
      "qa_types": [
        "unit"
      ]
    },
    {
      "ac_id": "AC-008",
      "theme": "canonical-envelope",
      "text": "任一元信息变更都先形成单一 canonical metadata envelope。",
      "tc_ids": [],
      "qa_types": []
    },
    {
      "ac_id": "AC-009",
      "theme": "three-sink-transaction",
      "text": "同一笔元信息事务会共享一致 transaction metadata，并投影到 human sink、machine sink、sqlite sink。",
