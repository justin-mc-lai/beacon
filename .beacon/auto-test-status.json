  "implementation_done": true,
  "evidence_done": true,
  "story_sequence": [
    {
      "ac_id": "AC-001",
      "theme": "general",
      "text": "`prototype` 默认与唯一正式模式是 `wireframe`，不再以 HTML 高保真原型作为交付语义。",
      "tc_ids": [
        "TC-001",
        "TC-011"
      ],
      "qa_types": [
        "interface",
        "unit"
      ]
    },
    {
      "ac_id": "AC-005",
      "theme": "general",
      "text": "Beacon 人类主链明确包含 `prototype` 阶段，且其职责固定为 wireframe freeze（位于 test-case 与 implement 之间）。",
      "tc_ids": [
        "TC-002",
        "TC-012"
      ],
      "qa_types": [
        "contract",
        "unit"
      ]
    },
    {
      "ac_id": "AC-006",
      "theme": "general",
      "text": "`beacon-prototype` 成为唯一 host-visible 原型子 skill，默认解释为 requirement-driven wireframe freeze。",
      "tc_ids": [
        "TC-003",
        "TC-013"
      ],
      "qa_types": [
        "integration",
        "unit"
      ]
    },
    {
      "ac_id": "AC-007",
      "theme": "general",
      "text": "`wireframe.py` 退出正式流程，不再作为平行入口与 `prototype` 竞争语义。",
      "tc_ids": [
        "TC-004",
        "TC-014"
      ],
      "qa_types": [
        "smoke",
        "unit"
      ]
    },
    {
      "ac_id": "AC-002",
      "theme": "general",
      "text": "wireframe 包可独立冻结页面清单、页面职责、路由关系、状态说明，不依赖 HTML 页面。",
      "tc_ids": [
        "TC-005",
        "TC-015"
      ],
      "qa_types": [
        "functional",
        "regression"
      ]
    },
    {
      "ac_id": "AC-003",
      "theme": "general",
      "text": "每个页面都可追溯到 PRD 承诺、user story 与 test-case 场景，满足 requirement-driven 闭环。",
      "tc_ids": [
        "TC-006",
        "TC-016"
      ],
      "qa_types": [
        "exception",
        "functional"
      ]
    },
    {
      "ac_id": "AC-004",
      "theme": "general",
      "text": "`v1.3.5` 输出只负责结构冻结，不反向篡改 `v1.3.6` 产品定义，且可被下游直接消费。",
      "tc_ids": [
        "TC-007",
        "TC-017"
      ],
      "qa_types": [
        "compatibility",
        "unit"
      ]
    },
    {
      "ac_id": "AC-008",
      "theme": "general",
      "text": "`state-flow-map` 可验证关键状态迁移、异常回退与 test-case 映射；缺失时 `prototype review` 必须阻断。",
      "tc_ids": [
        "TC-008"
      ],
      "qa_types": [
        "unit"
      ]
    },
    {
      "ac_id": "AC-009",
      "theme": "general",
      "text": "`component-catalog` 能建立组件职责/动作/状态与 AC/TC 映射；缺失时 `prototype freeze` 必须失败。",
      "tc_ids": [
        "TC-009"
      ],
      "qa_types": [
        "unit"
      ]
    },
    {
      "ac_id": "AC-010",
      "theme": "general",
      "text": "human/machine/sqlite 三写入点共享 `source_hash`、`projection_seq`、`transaction_id`；任一不一致必须标记 `drift` 并阻断 release pass。",
      "tc_ids": [
        "TC-010"
      ],
      "qa_types": [
        "unit"
      ]
    }
  ],
