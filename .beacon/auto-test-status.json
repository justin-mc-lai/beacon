  "story_sequence": [
    {
      "ac_id": "AC-001",
      "theme": "work-item-model",
      "text": "Beacon 能定义统一 work item 模型，至少覆盖 `item_id / item_type / feature / version / source_surface / priority / requested_action / truth_refs / status`。",
      "tc_ids": [
        "TC-001",
        "TC-028"
      ],
      "qa_types": [
        "interface",
        "unit"
      ]
    },
    {
      "ac_id": "AC-002",
      "theme": "run-model",
      "text": "每个已派发 work item 都会生成统一 run 记录，至少包含 `run_id / item_id / workspace_ref / runtime_mode / status / attempt_seq / next_action / evidence_refs`。",
      "tc_ids": [
        "TC-002",
        "TC-029"
      ],
      "qa_types": [
        "contract",
        "unit"
      ]
    },
    {
      "ac_id": "AC-003",
      "theme": "supported-item-types",
      "text": "最小 item type 集合至少覆盖 `team_task / ralph_step / real_project_validation_case / implement_delivery / qa_repair / release_closure`。",
      "tc_ids": [
        "TC-003",
        "TC-030"
      ],
      "qa_types": [
        "integration",
        "unit"
      ]
    },
    {
      "ac_id": "AC-004",
      "theme": "status-contract",
      "text": "run 状态至少覆盖 `queued / running / retry_waiting / blocked / handoff_required / completed / cancelled`。",
      "tc_ids": [
        "TC-004",
        "TC-031"
      ],
      "qa_types": [
        "smoke",
        "unit"
      ]
    },
    {
      "ac_id": "AC-005",
      "theme": "scheduler-contract",
      "text": "Beacon 提供统一 run scheduler，至少支持入队、派发、并发限制、continuation、失败重试、人工介入挂起与取消。",
      "tc_ids": [
        "TC-023"
      ],
      "qa_types": [
        "unit"
      ]
    },
    {
      "ac_id": "AC-006",
      "theme": "workspace-isolation",
      "text": "每个 run 都有独立 workspace boundary，并且能够绑定 run_id、控制清理策略、阻断越界写入。",
      "tc_ids": [
        "TC-024"
      ],
      "qa_types": [
        "unit"
      ]
    },
    {
      "ac_id": "AC-007",
      "theme": "retry-reconciliation",
      "text": "Beacon 显式支持 backoff retry、stale run detection、eligibility re-check、blocked -> repair -> resume、abandoned run reconciliation。",
      "tc_ids": [
        "TC-025"
      ],
      "qa_types": [
        "unit"
      ]
    },
    {
      "ac_id": "AC-008",
      "theme": "deterministic-recovery",
      "text": "对 `real-project-validation` 与 `qa repair` 一类失败 run，系统能给出明确恢复路径，而不是只能整条命令重跑。",
      "tc_ids": [
        "TC-026"
      ],
      "qa_types": [
        "unit"
      ]
    },
    {
      "ac_id": "AC-009",
      "theme": "runtime-board",
      "text": "Beacon 提供 runtime board，至少展示 running runs、retry queue、blocked/handoff runs、stage 分布、人工介入项与 next action。",
      "tc_ids": [
        "TC-027"
      ],
      "qa_types": [
        "unit"
      ]
    },
    {
      "ac_id": "AC-010",
      "theme": "evidence-driven-board",
      "text": "runtime board 优先显示高信号运行判断，而不是直接暴露 machine noise。",
      "tc_ids": [],
      "qa_types": []
    },
    {
      "ac_id": "AC-011",
      "theme": "delivery-bridge",
      "text": "orchestration runtime 能桥接 `implement / qa / release`，但不替代其正式闭环角色。",
      "tc_ids": [],
      "qa_types": []
    },
    {
      "ac_id": "AC-012",
      "theme": "truth-boundary",
      "text": "runtime 只做调度、状态、证据与桥接，不反向改写 `prd / user-story / test-case / prototype`。",
      "tc_ids": [],
      "qa_types": []
    },
    {
      "ac_id": "AC-013",
      "theme": "team-consumer",
      "text": "`team` 能以 work item 派发任务、以 run 观察任务、以 runtime board 观察整体运行态。",
      "tc_ids": [],
      "qa_types": []
    },
    {
      "ac_id": "AC-014",
      "theme": "ralph-controller",
      "text": "`ralph` 被明确定位为 `what next` controller，而不是直接持有所有执行态的执行器。",
      "tc_ids": [],
      "qa_types": []
    },
    {
      "ac_id": "AC-015",
      "theme": "validation-consumer",
      "text": "`real-project-validation` 支持 validation case -> work item -> per-run workspace -> retry/repair 的 runtime 接入路径。",
      "tc_ids": [],
      "qa_types": []
    },
    {
      "ac_id": "AC-016",
      "theme": "no-fragmented-schedulers",
      "text": "`team / ralph / validation / implement / qa` 不再各自维护不可见的私有调度语义。",
      "tc_ids": [],
      "qa_types": []
    },
    {
      "ac_id": "AC-017",
      "theme": "feature-aware-blueprint",
      "text": "`execution/architecture-blueprint.md` 的 managed projection 至少按 `feature_slug` 独立投影与独立校验，同版本多个 feature 不会互相覆盖。",
      "tc_ids": [],
      "qa_types": []
    },
    {
      "ac_id": "AC-018",
      "theme": "feature-scoped-gate",
      "text": "`implement plan / implement run / release gate` 只校验当前 feature 对应的 blueprint projection block，不把其他 feature block 误判成 drift。",
      "tc_ids": [],
      "qa_types": []
    },
    {
      "ac_id": "AC-019",
      "theme": "implementation-order-analysis",
      "text": "Beacon 能基于显式 feature dependency 与 writable/direct delivery service 冲突，自动生成 `ordered_feature_slugs / waves / depends_on_features / reason_code`。",
